/*
 * Example site config for -profile annotate,nrp (or annotate,k8s). Copy next
 * to your overlay in your deployment repo, fill in the values, and pass it to
 * every run:
 *
 *   nextflow run /data/src/nf_funannotate1 -profile annotate,nrp -c site.config ...
 *
 * The k8s{} scope is set here, not only params: -c files are read after the
 * profiles, so params set here are not visible to conf/site_nrp.config.
 * (A --k8s_namespace on the command line would be.)
 */
params {
    k8s_namespace = 'my-namespace'      // FILL IN: same as the overlay's namespace
    nrp_project   = 'my-nrp-project'    // FILL IN (NRP): same as the overlay's annotation
}

k8s {
    namespace = params.k8s_namespace
    // NRP usage accounting on every task pod; drop on other clusters.
    pod       = [[annotation: 'nrp-nautilus.io/project', value: params.nrp_project]]
}
