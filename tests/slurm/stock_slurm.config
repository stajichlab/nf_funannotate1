// Stock-SLURM overlay for CI: no partition names (cluster default), tiny
// resources. The `test` profile forces the local executor; -c has the last
// word, so re-assert slurm here to make jobs go through sbatch.
process.executor       = 'slurm'
process.clusterOptions = '-N 1 -n 1'
executor.queueSize     = 4
// The slurm profile polls once a minute and throttles submits to 30/min, which
// is right for a busy cluster but makes this tiny test take ~15 minutes.
executor.pollInterval    = '5 sec'
executor.queueStatInterval = '5 sec'
executor.submitRateLimit = '100/1sec'
