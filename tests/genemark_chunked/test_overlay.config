// Overlay for test_genemark_chunked.nf (repo root; projectDir must be the repo root for bin/ lookups): small genome thresholds, publish gtf/mod, short queue for the training task.
// Use with the real profiles:  -profile genemark_sidecar,slurm,singularity -c conf/site_ucr_hpcc.config -c conf/site_ucr_hpcc_singularity.config -c tests/genemark_chunked/test_overlay.config
params {
    genemark_chunked           = true
    genemark_chunk_min_contigs = 1000
    genemark_chunk_contigs     = 500
}
process {
    // the singularity-axis site config sends GENEMARK_TRAIN to epyc; use the 2 h short queue for this small test
    withName: '.*:GENEMARK_TRAIN' { queue = 'short'; time = '1h30m'; memory = '16 GB' }
    withName: '.*:(GENEMARK_TRAIN|GENEMARK_MERGE)' {
        publishDir = [path: "${params.target}/published", mode: 'copy', saveAs: { fn -> (fn.endsWith('.genemark.gtf') || fn.endsWith('.genemark.mod')) ? fn : null }]
    }
}
