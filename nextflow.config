/*
 * nf_funannotate1 — eukaryotic genome annotation framework
 *
 * Configuration is split into three ORTHOGONAL profile axes that combine on the
 * command line. Pick one from each axis:
 *
 *   pipeline      : annotate | earlgrey | test
 *   executor      : slurm    | local
 *   provisioning  : ucr_hpcc | pixi  | singularity
 *
 *   k8s | nrp     : Kubernetes -- replaces BOTH the executor and provisioning
 *                   picks (e.g. -profile annotate,nrp). See k8s/README.md.
 *
 * Provisioning is split into a PORTABLE path and an INSTITUTIONAL path:
 *   - singularity / pixi : portable — runnable at any site; tools come from
 *                          containers or project-local pixi envs.
 *   - ucr_hpcc           : institutional — UCR HPCC Lmod modules. Encodes
 *                          site-specific module names/paths; analogue of an
 *                          nf-core/configs institutional profile.
 *
 * Examples:
 *   -profile annotate,slurm,ucr_hpcc        (default / recommended on UCR HPCC)
 *   -profile annotate,local,singularity     (portable: containers, head local)
 *   -profile annotate,local,ucr_hpcc -stub-run (graph/dry test)
 *
 * The pipeline profile supplies params + per-label resources; the executor
 * profile selects SLURM vs local; the provisioning profile fills each process
 * label's `beforeScript` (ucr_hpcc/pixi) or `container` (singularity). Process
 * scripts themselves are tool-agnostic — they contain NO `module load` lines.
 */

manifest {
    name            = 'nf_funannotate1'
    author          = 'Jason Stajich'
    homePage        = 'https://github.com/stajichlab/nf_funannotate1'
    description     = 'Eukaryotic (fungal-default) genome annotation: clean, mask, RNA-seq train, funannotate predict/annotate/update, antismash/interpro/signalp'
    version         = '0.3.0'
    nextflowVersion = '>=25.10.0'
    // Entry script for `nextflow run stajichlab/nf_funannotate1`.
    // earlgrey_mask.nf is a separate entry; run it with an explicit script path.
    mainScript      = 'funannotate.nf'
}

// Parameter validation + typed --help, driven by nextflow_schema.json (nf-schema).
// Unrecognised params default to warnings (not errors) — earlgrey_mask.nf has its own
// param set and must not hard-fail on this schema.
plugins {
    id 'nf-schema@2.7.2'
    // Needed only by -profile k8s / nrp (conf/executor_k8s.config), but
    // `plugins {}` is only valid at the top-level config scope, not inside a
    // profile. nf-k8s ships as a separate plugin since Nextflow 24.x and its
    // auto-install on first k8s use is broken on 25.10.x
    // (nextflow-io/nextflow#6583), so it's declared explicitly here. Inert
    // under the slurm/local executors.
    id 'nf-k8s'
}

// NF 26.x passes CLI args as strings; lenientMode lets nf-schema accept "true"/"1"
// where the schema declares boolean/integer — actual Groovy types are already correct.
validation {
    lenientMode    = true
    monochromeLogs = false
}

// ── Shared params (pipeline profiles add their own) ───────────────────────────
params {
    samples    = "${launchDir}/samples.csv"
    n_test     = 0
    // Restrict to a taxonomic group: --taxon RANK:VALUE (e.g. PHYLUM:Ascomycota).
    // Ranks come from samples.csv columns (PHYLUM, SUBPHYLUM, CLASS, ORDER, FAMILY, GENUS).
    taxon      = ''
    // Restrict to a single assembly: --asmid GCA_000001405.15
    asmid      = ''
    // Optional newline/CSV list of ASMIDs to skip.
    suppress   = "${launchDir}/suppress.txt"
    debug      = false
    // GenBank/funannotate locus-tag header length cap. Was a hardcoded constant (24)
    // threaded through the per-sample tuple; promoted to a param ahead of the meta-map
    // conversion (REFACTORING_PLAN.md Principle 0) since it is global, not per-sample.
    header_length = 24
    // --help prints the schema-driven parameter help and exits (see funannotate.nf).
    help       = false

    // Directory holding locally-built/pulled Singularity/Apptainer .sif images
    // (conf/provision_singularity.config) and doubling as the apptainer pull
    // cache (apptainer.cacheDir below). Resolved from the first of these env
    // vars that's set -- NXF_APPTAINER_CACHE, NXF_SINGULARITY_CACHE,
    // APPTAINER_CACHE (checked in that order since this pipeline runs under
    // Nextflow's `apptainer` engine directive, not `singularity`; see that
    // comment below) -- falling back to this site's shared cache. Override
    // per-site with --sif_dir /path/to/cache, or just export one of those env
    // vars before launching.
    sif_dir    = System.getenv('NXF_APPTAINER_CACHE') ?: System.getenv('NXF_SINGULARITY_CACHE') ?: System.getenv('APPTAINER_CACHE') ?: '/bigdata/stajichlab/shared/lib/singularity_cache'

    // funannotate image (the 'funannotate' label under -profile singularity;
    // see conf/provision_singularity.config). Set here, not in that file, so
    // every provisioning axis has it: params.container_mariadb (PASA MySQL)
    // defaults to this image, which bundles MariaDB.
    container_funannotate = 'docker://ghcr.io/nextgenusfs/funannotate:v1.9.0-rc.3'        // pinned; same image as BFD's funannotate-1.9.0-rc.3.sif (base digest sha256:81c85ccb...; v-prefixed tag, 1.9.0-rc.3 is the same digest). rc.3 adds the training-selection fixes, the PASA R1 CIGAR fix and the RNA-seq/PASA training gates on top of rc.1's PASA duplicate-output-loop fix. Rust EVM engine (norust: v1.9.0-rc.3-norust). .sif build: 'apptainer pull docker://ghcr.io/nextgenusfs/funannotate:v1.9.0-rc.3'
}

// ── Base resource tiers + per-module publishDir (applied before profiles) ─────
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ── Process defaults (apply to every process, every profile) ──────────────────
// NOTE: no `shell` override here. A login shell (-l) is required under
// ucr_hpcc/pixi so /etc/profile.d/modules.sh + `module load` work, but the
// SAME login shell re-sources the host's dotfiles from $HOME inside a
// container (apptainer autoMounts $HOME), which resets PATH and hides
// wherever the image actually installs its tools (funannotate's /venv/bin,
// braker3/genemark's /opt/conda/bin, etc). So `-l` is set per-profile in
// ucr_hpcc/pixi below instead of globally -- singularity keeps Nextflow's
// plain default shell, which leaves the container's own PATH untouched.
process {
    errorStrategy  = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries     = 2
    cache          = 'lenient'   // required for -resume on shared networked FS
    // INTERPROSCAN_RUN (IPS6) runs on the host on EVERY provisioning axis: it
    // launches a nested `nextflow run` whose own tasks use containers, so
    // it needs the container engine on PATH whichever axis is active.
    // withLabel outranks the axes' generic process.beforeScript / shell.
    // Plain (non-login) shell: the ucr_hpcc/pixi axes run task scripts in
    // `bash -l`, and on UCR a login shell drops the module-loaded apptainer
    // from PATH again (checked 2026-09-28), so the nested IPS6 tasks failed
    // with "env: 'apptainer': No such file or directory". This task needs no
    // Lmod module of its own, so it does not need the login shell.
    withLabel: 'interproscan6' {
        shell        = ['/bin/bash']
        beforeScript = 'source /etc/profile.d/modules.sh 2>/dev/null || true; module load apptainer 2>/dev/null || true'
    }
    // NOTE: no clusterOptions here. `-N 1 -n 1` is SLURM syntax and lives in
    // the `slurm` profile below -- process.clusterOptions would otherwise leak
    // SLURM flags into every executor (invalid on PBS/LSF/SGE clusters).
}

// ── Singularity (off unless the `singularity` provisioning profile is active) ──
// apptainer{}, not singularity{}: the installed binary here IS apptainer (the
// singularity project's successor), and Nextflow's `singularity` engine
// directive hardcodes the legacy SINGULARITYENV_* variable prefix regardless,
// which apptainer accepts but warns about on every single container
// invocation ("Environment variable SINGULARITYENV_* is set, but
// APPTAINERENV_* is preferred"). Nextflow's separate `apptainer` engine
// directive uses the APPTAINERENV_* prefix natively, eliminating the warning
// at the source. Directive names and semantics are otherwise identical to
// singularity{} (this pipeline's -profile singularity name is unchanged; only
// the internal engine directive moved).
apptainer {
    enabled      = false
    autoMounts   = true
    cacheDir     = params.sif_dir
    envWhitelist = 'SCRATCH'
    // --nv: expose GPUs when present (no-op without --gres). -B $SCRATCH: on UCR
    // HPCC $SCRATCH is node-local NVMe (see CLAUDE.md), NOT auto-mounted by
    // apptainer -- any containerized process that writes under $SCRATCH (e.g.
    // GENOME_CLEAN's decompress-then-clean step) silently can't see its own
    // output without this bind. $SCRATCH is expanded by the shell when
    // .command.run invokes singularity/apptainer (it's set per-SLURM-job), not
    // by Nextflow at config-parse time, so this must stay single-quoted here.
    // runOptions is appended alongside any per-label containerOptions rather
    // than being overridden by it, so this applies to every container globally.
    // ${SCRATCH:+...} (not plain $SCRATCH) so this is a no-op -- not a broken
    // `-B :` -- at sites where $SCRATCH isn't set (the clean scripts already
    // fall back to '.' there).
    runOptions   = '--nv ${SCRATCH:+-B $SCRATCH:$SCRATCH}'
}

// ── Profiles (three orthogonal axes + composite test) ─────────────────────────
profiles {

    // ---- executor axis -------------------------------------------------------
    slurm {
        process.executor = 'slurm'
        // SLURM-specific one-node/one-task request, applied to every process
        // only when this executor is active. Scoped here (not globally) so
        // non-SLURM executors/locations never see `-N 1 -n 1` flags; more
        // specific withName:/withLabel: clusterOptions (GPU gres, job names in
        // provision_*.config) still override this per label.
        process.clusterOptions = '-N 1 -n 1'
        executor {
            name            = 'slurm'
            queueSize       = 400
            submitRateLimit = '30/1min'
            pollInterval    = '1 min'
            exitReadTimeout = '30 min'
            // Query job status across all partitions (squeue without -p),
            // not only the job's submission queue. Processes here span
            // several partitions (epyc, short, gpu, highmem).
            queueGlobalStatus = true
        }
        // Generic GPU request for the two GPU-capable tools. No partition
        // name or node list: SLURM picks a partition that has GPUs, or the
        // site config sets `queue` (UCR: conf/provision_ucr_hpcc.config,
        // loaded later, overrides these). Set signalp_gpu / deeptmhmm_gpu on the
        // command line or in -params-file (not a -c file): these are
        // evaluated when the config is parsed.
        process {
            withName: '.*:SIGNALP_RUN' {
                clusterOptions = params.signalp_gpu ? '-N 1 -n 1 --gres=gpu:1' : '-N 1 -n 1'
            }
            withName: '.*:DEEPTMHMM_ANNOTATION' {
                clusterOptions = params.deeptmhmm_gpu ? '-N 1 -n 1 --gres=gpu:1' : '-N 1 -n 1'
            }
        }
    }
    local {
        process.executor = 'local'
        executor {
            name      = 'local'
            queueSize = 4
        }
    }
    // Kubernetes: executor AND provisioning in one (task pods need OCI images,
    // so it can't combine with ucr_hpcc/pixi/conda/singularity). Reuses the
    // singularity axis's label -> image map, then conf/executor_k8s.config
    // converts it for pods. Put the pipeline profile first:
    //   -profile annotate,nrp            (NRP Nautilus; conf/site_nrp.config)
    //   -profile annotate,k8s -c site.config   (any other cluster)
    // Launch from a pod inside the cluster -- see k8s/README.md.
    k8s {
        includeConfig 'conf/provision_singularity.config'
        includeConfig 'conf/executor_k8s.config'
    }
    nrp {
        includeConfig 'conf/provision_singularity.config'
        includeConfig 'conf/executor_k8s.config'
        includeConfig 'conf/site_nrp.config'
    }

    // ---- provisioning axis ---------------------------------------------------
    // Institutional (UCR HPCC Lmod). Portable alternatives: pixi, singularity.
    ucr_hpcc    {
        // Login shell so /etc/profile.d/modules.sh + `module load` (used by every
        // withLabel beforeScript in provision_ucr_hpcc.config) actually work.
        process.shell = ['/bin/bash', '-l']
        includeConfig 'conf/provision_ucr_hpcc.config'
        // UCR-specific reference-database/config path overrides (only relevant
        // when the `annotate` pipeline profile is also loaded; see
        // conf/site_ucr_hpcc.config for what it repoints and why).
        includeConfig 'conf/site_ucr_hpcc.config'
    }
    pixi        {
        // Same rationale as ucr_hpcc: provision_pixi.config's beforeScripts
        // source /etc/profile.d/modules.sh to `module load pixi` first.
        process.shell = ['/bin/bash', '-l']
        includeConfig 'conf/provision_pixi.config'
    }
    conda       {
        // Unlike ucr_hpcc/pixi, this axis deliberately uses a PLAIN (non-login)
        // shell: the login shell (-l) re-sources the host's dotfiles, which
        // rebuild PATH and discard the conda env activation performed in
        // provision_conda.config's beforeScript (observed as `funannotate:
        // command not found` in task shells). The conda beforeScripts are
        // self-contained — they `source /etc/profile.d/modules.sh` themselves
        // before `module load miniconda3` — so no login shell is required.
        // Pick the release with --conda_env (e.g. funannotate-1.8.17,
        // funannotate-master, funannotate-1.9.0-beta.12). See
        // conf/provision_conda.config and environments/conda/README.md.
        process.shell = ['/bin/bash']
        includeConfig 'conf/provision_conda.config'
    }
    singularity {
        apptainer.enabled = true
        // Unlike ucr_hpcc/pixi, this axis deliberately uses a PLAIN (non-login)
        // shell: `apptainer exec` runs .command.sh via process.shell *inside* the
        // container, and a login shell (-l, ucr_hpcc's default) re-sources host
        // profile scripts there too, wiping out the image's own baked PATH (e.g.
        // funannotate images that only put their toolchain at /pixi/.pixi/envs/
        // base/bin via image-level ENV, not a profile.d script) -- observed as
        // "funannotate: command not found" even though `apptainer exec <sif>
        // which funannotate` resolves fine outside a login shell. Matches the
        // conda axis's identical rationale for the same override.
        process.shell = ['/bin/bash']
        // Nextflow's own container engine invocation (the `singularity`/
        // `apptainer` binary that pulls/execs images) still has to be on PATH
        // in each job's shell -- on UCR HPCC that's Lmod-gated, and a fresh
        // SLURM job script doesn't inherit the submitting shell's `module
        // load`. This is a no-op where Lmod isn't present, so it doesn't
        // compromise the profile's portability to other sites.
        process.beforeScript = 'source /etc/profile.d/modules.sh 2>/dev/null || true; module load apptainer 2>/dev/null || true'
        includeConfig 'conf/provision_singularity.config'
    }

    // ---- pipeline axis -------------------------------------------------------
    annotate    { includeConfig 'conf/profile_annotate.config'      }
    earlgrey    { includeConfig 'conf/profile_earlgrey.config'      }
    // genemark_sidecar.nf secondary entry (`-main-script genemark_sidecar.nf`):
    // run GeneMark once per genome, out of band, for --genemark_sidecar_dir
    // consumers. See genemark_sidecar.nf's header.
    genemark_sidecar { includeConfig 'conf/profile_genemark_sidecar.config' }

    // ---- test / stub (self-contained: own resources + beforeScript=':') ------
    test        { includeConfig 'conf/test.config'                  }
    stub {
        includeConfig 'conf/test.config'
        params.n_test = 2
    }
}

