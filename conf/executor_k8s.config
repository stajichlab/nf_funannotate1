/*
 * Executor + provisioning: Kubernetes (-profile k8s, or -profile nrp for the
 * NRP Nautilus site settings on top — see conf/site_nrp.config).
 *
 * Loaded AFTER conf/provision_singularity.config (see the `k8s` profile in
 * nextflow.config): that file supplies the label -> container map; this file
 * turns it into something a Kubernetes pod can run. List the pipeline profile
 * FIRST so this file's overrides win: -profile annotate,nrp
 *
 * Why this differs from -profile singularity:
 *   - Every task is its own pod, started by the cluster's container runtime
 *     from an OCI image reference. apptainer.enabled is off (profile_annotate
 *     turns it on globally; left on, Nextflow rewrites image names into .sif
 *     cache paths), .sif files and depot.galaxyproject.org SIF URLs can't be
 *     used as pod images, and `containerOptions` (the -B binds / --nv / --env
 *     in provision_singularity.config) is ignored by the k8s executor.
 *   - There is no apptainer inside a pod, so the modules that build their own
 *     `apptainer exec` (GENEMARK_RUN, PRODIGAL_RUN, SETUP_MARIADB_DATADIR) run
 *     in "host mode" with the right image as the whole task's container.
 *   - Every task needs an image; processes that run bare on the host under
 *     singularity/slurm (report/deliver/earlgrey/repeatmask labels) get
 *     process.container = the funannotate image (bash, python, perl, gzip).
 *   - All pods run as root (k8s.runAsUser = 0): the images disagree on their
 *     default user (funannotate, busco_user, uid 1000, root) and every task
 *     writes into task dirs on the same shared PVC.
 *
 * Not provisioned here (turn off for k8s runs until their images are in a
 * registry the pods can pull from): signalp, deeptmhmm, antismash (locally
 * built .sif images, the first two licensed), and GENOME_CLEAN's FCS-GX purge
 * (~470 GB DB staged into /dev/shm) — use --skip_fcs true.
 *
 * Site-specific values (namespace, PVC, service account, reference-DB paths)
 * come from a site file: conf/site_nrp.config, or -c your own copy.
 */

params {
    // OCI references for the images provision_singularity.config points at
    // as depot.galaxyproject.org SIF downloads or local .sif files (same tags).
    container_edirect      = 'quay.io/biocontainers/entrez-direct:22.4--he881be0_0'
    container_setup        = 'quay.io/biocontainers/gnu-wget:1.18--h36e9172_9'
    container_skani        = 'quay.io/biocontainers/skani:0.3.2--h79ce301_0'
    container_busco        = 'quay.io/biocontainers/busco:6.1.0--pyhdfd78af_1'
    container_genome_clean = 'ghcr.io/stajichlab/aaftf:latest'

    // No nested apptainer in a pod: GENEMARK_RUN / PRODIGAL_RUN use their
    // host-mode branch, run inside the label's container below.
    genemark_container_mode = false
    prodigal_container_mode = false
    mariadb_setup_in_image  = true
    // funannotate predict works on the pod's local disk, not the shared PVC
    // (CephFS metadata round-trips made BUSCO training crawl; see
    // modules/local/funannotate_predict.nf). Only final results hit the PVC.
    predict_local_scratch   = true

    // Optional GeneMark license key on the shared PVC (e.g. /data/home/.gm_key),
    // copied to $HOME/.gm_key inside the GENEMARK_RUN pod. null = don't copy.
    // Not needed for the default braker3 image: its GeneMark-ES/ET/ETP build
    // ran --ES to completion with no key (NRP test pod, 2026-09-26). Only for
    // a --container_genemark image with a key-gated GeneMark.
    gm_key = null

    // Upper bounds for any single task pod. profile_annotate's retry
    // escalations go up to 32 cpus / 256 GB; very large pods can sit
    // Pending for a long time on a shared cluster.
    k8s_max_cpus   = 32
    k8s_max_memory = '128.GB'
}

apptainer.enabled   = false
singularity.enabled = false
docker.enabled      = true

executor {
    name            = 'k8s'
    queueSize       = 100
    submitRateLimit = '10/1min'
}

k8s {
    // namespace / serviceAccount / storageClaimName / storageMountPath: site file.
    computeResourceType = 'Pod'
    // Set a CPU limit equal to the request. Namespaces with a LimitRange
    // default CPU limit (NRP: 100m) otherwise reject every task pod.
    cpuLimits           = true
    // Run every pod as root. NOT `runAsUser = 0`: nf-k8s applies that
    // shortcut via `if( runAsUser )`, and Groovy treats 0 as false, so it is
    // silently dropped (pods then run as each image's own user and can't
    // write the root-owned task dirs). The map form is passed through as-is.
    securityContext     = [runAsUser: 0]
}

process {
    executor       = 'k8s'
    shell          = ['/bin/bash']
    // Default image for processes provision_singularity.config leaves on the host.
    container      = { (params.container_funannotate as String).replaceFirst('^docker://', '') }
    resourceLimits = [ cpus: params.k8s_max_cpus as int, memory: params.k8s_max_memory ]
    // The singularity axis's `module load apptainer` loader is meaningless in a pod.
    beforeScript   = ':'

    // docker:// is an apptainer URI scheme; pods need a bare OCI reference.
    // Closures so a --container_* CLI override is stripped too.
    withLabel: 'funannotate'  { container = { (params.container_funannotate as String).replaceFirst('^docker://', '') } }
    withLabel: 'sra'          { container = { (params.container_sra as String).replaceFirst('^docker://', '') } }
    withLabel: 'interproscan' { container = { (params.container_interproscan as String).replaceFirst('^docker://', '') } }
    // provision_singularity.config assigned these labels' containers eagerly
    // (plain strings, resolved when that file loaded), so the params above
    // don't reach them on their own — re-point each label explicitly.
    withLabel: 'genome_clean' { container = { params.container_genome_clean } }
    withLabel: 'setup'        { container = { params.container_setup } }
    withLabel: 'skani'        { container = { params.container_skani } }
    withLabel: 'busco_genome' { container = { params.container_busco } }
    withLabel: 'busco_completeness' {
        container    = { (params.container_busco_completeness as String).replaceFirst('^docker://', '') }
        beforeScript = ':'
    }
    // edirect: the Time::HiRes perl shim was injected via apptainer --env
    // (containerOptions), which k8s ignores — export PERL5LIB directly.
    withLabel: 'edirect' {
        container    = { params.container_edirect }
        beforeScript = { "export PERL5LIB=${projectDir}/assets/perl_shims\${PERL5LIB:+:\$PERL5LIB}" }
    }
    // GeneMark: whole task in the braker3 image (gmes_petap.pl, bam2hints,
    // join_mult_hints.pl, python and gzip are all on its PATH).
    withLabel: 'genemark' {
        container    = { (params.container_genemark as String).replaceFirst('^docker://', '') }
        beforeScript = { params.gm_key ? "[ -s '${params.gm_key}' ] && cp '${params.gm_key}' \"\$HOME/.gm_key\" || true" : ':' }
    }
    // PRODIGAL_RUN also needs python for bin/prodigal_gff_hier.py; the
    // prodigal biocontainer has none. Falls through to process.container
    // (funannotate image) — UNVERIFIED that it ships prodigal; keep
    // --run_prodigal false (the default) until checked.

    // Was `container = false` (host apptainer); now runs inside the MariaDB
    // image itself (params.mariadb_setup_in_image).
    withName: '(.*:)?SETUP_MARIADB_DATADIR' {
        container = { (params.container_mariadb ?: params.container_funannotate).toString().replaceFirst('^docker://', '') }
    }
}
