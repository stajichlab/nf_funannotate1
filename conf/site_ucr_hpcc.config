/*
 * Site overrides: UCR HPCC — reference-database / config paths.
 *
 * conf/profile_annotate.config sets portable, launchDir-relative defaults for
 * every reference-database and config path (source, taxondb, eggnog_db,
 * busco_lineages, pasa_conf_dir) so the pipeline runs at any site out of the
 * box (auto-downloaded DBs land under launchDir; unmanaged ones need a
 * populated launchDir/<name> or an explicit --override). This file repoints
 * those at UCR's existing shared installs so UCR runs reuse them instead of
 * re-downloading/re-populating per project.
 *
 * Included by the `ucr_hpcc` PROVISIONING profile in nextflow.config (not a
 * separate axis) -- same name, now also carrying these pipeline-level
 * reference-path overrides alongside its original Lmod-provisioning meaning.
 * Harmless to include when the `annotate` pipeline profile isn't loaded (its
 * params just go unused).
 *
 * To add another site's shared installs: copy this file to
 * conf/site_<site>.config, point the params at that site's paths, and
 * includeConfig it from that site's provisioning profile in nextflow.config.
 */

params {
    // NCBI_ASM source dir for the 1KFG fungal genome project.
    source         = "/bigdata/stajichlab/shared/projects/1KFG/2026/NCBI_fungi/source/NCBI_ASM"
    // Shared taxonkit/NCBI taxdump download, reused across projects instead of
    // each launchDir re-fetching its own copy via SETUP_TAXONDB.
    taxondb        = "/bigdata/stajichlab/shared/projects/1KFG/2026/NCBI_fungi/tmp/taxa/"
    // Shared eggNOG-mapper database install (not auto-downloaded by this pipeline).
    eggnog_db      = "/srv/projects/db/eggNOG/LATEST"
    // Shared BUSCO v10-format lineage tree (not auto-downloaded by this pipeline).
    busco_lineages = '/srv/projects/db/BUSCO/v10/'
    // Shared PASA config templates (my.cnf + conf.txt) for the mysql backend.
    pasa_conf_dir  = "/rhome/jstajich/.pasa/pasa_conf/"
    // Shared antiSMASH reference databases (populated once with
    // download-antismash-databases) instead of each launchDir re-downloading
    // its own copy via SETUP_ANTISMASH_DB.
    antismash_db   = "/bigdata/stajichlab/shared/lib/antismash_db"
    // Prebuilt shared funannotate DB (populated via `funannotate setup -d
    // ...`; see profile_annotate.config's documented override) so
    // SETUP_FUNANNOTATE_DB reuses it instead of starting from scratch --
    // otherwise it tries to download BUSCO lineages from osf.io at run time
    // (transient 502s) and re-populates per launchDir.
    funannotate_db = "/bigdata/stajichlab/shared/lib/funannotate_db"
}

// ── UCR container-axis prerequisites (singularity provisioning profile) ──────
// Portable conf/provision_singularity.config deliberately sets no beforeScript
// and relies on apptainer.autoMounts ($PWD/$HOME) for path visibility. That
// is not enough on UCR compute nodes:
//   * launchDir-adjacent writes land under /bigdata (input_clean_genomes/,
//     work/mysql_datadir, ...) and reference DBs/symlink targets live in
//     /bigdata /srv/projects /rhome/jstajich/.pasa -- all outside $PWD/$HOME,
//     so containerized tasks hit "Read-only file system" or can't see the DB.
//   * The task PATH has no BLAST/module binaries; individual jobs DO carry the
//     apptainer binary, but relying on that is implicit.
// Bound globally via apptainer.runOptions: appended alongside (not replaced
// by) any per-label containerOptions, so this applies to every container
// while keeping the existing --nv/$SCRATCH behavior -- the base value from
// nextflow.config must be repeated here because a -c overlay replaces it.
apptainer {
    runOptions = '--nv ${SCRATCH:+-B $SCRATCH:$SCRATCH} -B /bigdata:/bigdata -B /srv/projects:/srv/projects -B /rhome/jstajich/.pasa:/rhome/jstajich/.pasa -B /rhome/jstajich/projects/nf/nf_funannotate1:/rhome/jstajich/projects/nf/nf_funannotate1'
}
