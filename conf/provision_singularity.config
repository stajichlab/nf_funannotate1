/*
 * Provisioning: Singularity containers (most portable; same image on HPCC + k8s).
 *
 * `apptainer.enabled` is flipped on by the `singularity` profile in
 * nextflow.config; this file maps each process label to a container image.
 * Images are params so they can be overridden on the CLI, e.g.
 *   --container_funannotate /path/to/funannotate.sif
 *
 * Public biocontainers are used where one exists. Tools without a ready image
 * (funannotate, AAFTF, signalp, the multi-tool SRA env) point at PLACEHOLDER
 * .sif paths under sif_dir that you build — see comments below.
 *
 * No `beforeScript` is set here: inside the container the tools are already on
 * PATH, so process scripts (which carry no `module load`) run as-is.
 */

params {
    // Directory holding locally-built .sif images.
    sif_dir = '/bigdata/stajichlab/shared/lib/singularity_cache'

    // Public biocontainers (override if you mirror them locally).
    container_edirect      = 'https://depot.galaxyproject.org/singularity/entrez-direct:22.4--he881be0_0'
    // Official antismash/standalone:8.0.4 Docker image -- its own DB
    // pre-build step works cleanly (unlike the bioconda-mirror 8.0.1 build,
    // which tries to write into its own read-only site-packages during
    // that step and fails). But the bare upstream image is missing `ps`
    // (procps), which Nextflow needs inside every container for its own
    // task resource-metric sampling ("Command 'ps' required by nextflow to
    // collect task metrics cannot be found" -- confirmed). Built from
    // ~/projects/containers/antismash_container/antismash-standalone-8.0.4-procps.def:
    // the bare upstream image plus `apt-get install procps`, nothing else
    // changed.
    container_antismash    = '/bigdata/stajichlab/shared/lib/singularity_cache/antismash-standalone-8.0.4-procps.sif'
    container_interproscan = 'docker://interpro/interproscan:6.0.0'
    container_setup        = 'https://depot.galaxyproject.org/singularity/gnu-wget:1.18--h36e9172_9'
    container_skani        = 'https://depot.galaxyproject.org/singularity/skani:0.3.2--h79ce301_0'
    container_busco        = 'https://depot.galaxyproject.org/singularity/busco:6.1.0--pyhdfd78af_1'

    // Locally-built images (BUILD THESE). Default to <sif_dir>/<name>.sif.
    container_funannotate  = 'docker://ghcr.io/nextgenusfs/funannotate:1.9.0-beta.8'         // pinned; adds --tmhmm/parseTMHMM (.sif build: 'apptainer pull docker://ghcr.io/nextgenusfs/funannotate:1.9.0-beta.8')
    container_genome_clean = '/bigdata/stajichlab/shared/lib/singularity_cache/AAFTF.sif'    // AAFTF + taxonkit + FCS-GX
    container_sra          = '/bigdata/stajichlab/shared/lib/singularity_cache/sra_tools.sif' // sratoolkit+fastp+bbtools+seqkit+aria2
    // Built from ~/projects/containers/signalp_container/signalp6-fast.def
    // (Bootstrap: interpro/signalp:6.0i). Licensed DTU tarball + ~1.6GB
    // distilled model weights baked in at build time -- no runtime bind
    // needed for the image itself. "fast" mode only (that's all the
    // licensed fast tarball ships). The baked TorchScript checkpoint is
    // saved for CPU, so GPU inference (~8x faster, benchmarked in
    // signalp_container/README.md) needs a converted copy of the weights
    // at runtime -- see params.signalp_gpu / signalp_gpu_models below.
    container_signalp      = '/bigdata/stajichlab/shared/lib/singularity_cache/signalp6-fast.sif'
    // Public, redistributable image — no private build needed. BRAKER's team
    // bundles GeneMark-ES/ET/EP/ETP 4.72 from gatech-genemark's
    // CC-BY-NC-SA-4.0-relicensed release (github.com/Gaius-Augustus/GeneMark-ETP-co-assembly),
    // not the old key-gated topaz.gatech.edu tarball, so the *binary* ships
    // freely. That does NOT mean GeneMark's own license is waived, though: per
    // BFD's genemark_run.nf (GENEMARK_RUN_DESIGN.md "Update 2026-08-18"),
    // gmes_petap.pl still expects a user-obtained ~/.gm_key regardless of which
    // image runs it -- an earlier "works with no key" read here likely picked
    // up a key already present in $HOME via apptainer.autoMounts rather than
    // proving one is unneeded. GENEMARK_RUN resolves and binds it defensively
    // (see genemark_run.nf) so this holds even where $HOME doesn't already
    // have a valid key. It also carries Augustus's bam2hints/join_mult_hints.pl
    // on PATH for ET-mode hint prep.
    container_genemark      = 'docker://teambraker/braker3:v3.1.1'
    // Built from ~/projects/containers/deeptmhmm_container/deeptmhmm.def
    // (Bootstrap: docker, From: interpro/deeptmhmm:1.0 -- torch==1.13.1+cu117,
    // Ada-GPU-capable). biswasaneel/deeptmhmm:latest (torch==1.5.0+cu92) was
    // tried first and confirmed GPU-dead on this cluster's RTX 6000 Ada nodes
    // (cublas runtime error, no sm_89 kernels). Licensed
    // DeepTMHMM-Academic-License-v1.0 code + weights are baked in at
    // /opt/deeptmhmm at build time (via %files) -- no runtime bind needed.
    container_deeptmhmm     = '/bigdata/stajichlab/shared/lib/singularity_cache/DeepTMHMM-1.0.sif'

    // See genemark_path in conf/profile_annotate.config and the 'genemark'
    // withLabel comment below for why GENEMARK_RUN has no process `container =`
    // and instead consults this flag to build its own `apptainer exec` calls.
    genemark_container_mode = true
}

// Built once, as a params entry rather than a local `def` (Nextflow's config
// DSL rejects a bare `def` mixed with config statements, but a `params.x =`
// assignment is itself a config statement and is allowed anywhere), and
// reused below rather than repeated inline: a bare `containerOptions =` on a
// withName selector REPLACES rather than merges with a withLabel selector's
// containerOptions for the same task (Nextflow applies the most specific
// matching selector's containerOptions wholesale, it does not concatenate
// across selectors) -- confirmed this silently dropped these binds for
// FUNANNOTATE_ANNOTATE (label 'funannotate', see modules/local/
// funannotate_annotate.nf), which matches both the withLabel: 'funannotate'
// block below AND the withName:'.*:FUNANNOTATE_ANNOTATE' block further down,
// and was keeping only that block's eggnog_db bind. Not meant for CLI
// override (there's nothing to override -- it's derived from other params).
params.funannotate_binds = ([
    new File(params.funannotate_db).canonicalPath,
    new File(params.proteins).canonicalFile.parent,
    projectDir.toString()
].unique() + params.busco_lineages).collect { "-B ${it}:${it}" }.join(' ')

process {
    // params.funannotate_db (launchDir/funannotate_db) is a symlink to shared
    // storage OUTSIDE the launch directory tree (/bigdata/stajichlab/shared/lib/
    // funannotate_db) -- apptainer.autoMounts only binds launchDir, so without
    // an explicit bind here the container sees the symlink but not what it
    // points at, and funannotate predict/train/update/annotate/setup silently
    // can't find any DB file under it (confirmed: "Can't find Repeat Database
    // at .../funannotate_db/repeats.dmnd" even though the file is right there
    // on the host). Binding directly onto the symlink's OWN path
    // (-B .../funannotate_db:.../funannotate_db) does NOT work once that path
    // is already nested inside the outer launchDir bind -- apptainer silently
    // fails to overlay a mount onto a symlink node there (confirmed by direct
    // testing). Resolving to the real target path first and binding THAT
    // (still 1:1, same source/dest) works correctly, and the symlink then
    // resolves through it fine too. canonicalPath is a no-op (binds itself)
    // at any site where funannotate_db isn't a symlink.
    // Same story for params.proteins and params.sbt_template: both are
    // launchDir/lib symlinks into shared storage (BFD/Fungi_BFD/lib/), also
    // outside the launchDir bind. Bind their common real parent directory
    // once rather than each file individually.
    //
    // Individual lineage entries INSIDE funannotate_db can themselves be
    // symlinks to yet another external location (e.g. funannotate_db/
    // mucoromycota_odb10 -> /srv/projects/db/BUSCO/v10/lineages/mucoromycota_odb10)
    // -- binding funannotate_db itself doesn't make that further-nested
    // target visible too (confirmed: "mucoromycota_odb10 busco database is
    // not found"). params.busco_lineages is that same /srv path and is
    // already proven to work as a direct bind for the busco_genome label
    // below (not nested inside another bind there), so reuse it here too.
    // Also binds workflow.projectDir: FUNANNOTATE_PREDICT invokes this
    // pipeline's own bin/asm_preflight_stats.py by absolute
    // ${workflow.projectDir}/bin/... path (same shared preflight guard
    // GENEMARK_RUN uses -- see genemark_run.nf), which -- like
    // funannotate_db/proteins above -- sits outside the task workdir apptainer
    // autoMounts covers, and outside launchDir entirely whenever the pipeline
    // is launched from the Nextflow asset cache (`nextflow run
    // stajichlab/nf_funannotate1`) rather than a local checkout.
    withLabel: 'funannotate'   {
        container        = params.container_funannotate
        containerOptions = params.funannotate_binds
    }
    withLabel: 'genome_clean'  { container = params.container_genome_clean }
    withLabel: 'edirect'       { container = params.container_edirect      }
    withLabel: 'sra'           { container = params.container_sra          }
    // params.antismash_db lives outside launchDir (shared storage, like
    // funannotate_db) -- needs an explicit bind for the same reason.
    withLabel: 'antismash'     {
        container        = params.container_antismash
        containerOptions = "-B ${params.antismash_db}:${params.antismash_db}"
    }
    withLabel: 'interproscan'  { container = params.container_interproscan }
    // GPU by default -- see params.signalp_gpu / signalp_run.nf. The baked-in
    // fast-mode checkpoint is CPU-saved, so GPU inference needs both --nv
    // AND a converted copy of the weights (signalp_run.nf handles the
    // one-time conversion, cached at params.signalp_gpu_models). That cache
    // lives under params.sif_dir, which -- unlike params.target/training_target
    // (under launchDir, covered by apptainer.autoMounts) -- is OUTSIDE the
    // launch directory tree, so it needs an explicit bind or the container
    // can't see its own cached conversion (confirmed: autoMounts only binds
    // launchDir, not arbitrary host paths referenced in a script's ${params.*}
    // string interpolation).
    withLabel: 'signalp'       {
        container        = params.container_signalp
        containerOptions = params.signalp_gpu ? "--nv -B ${params.sif_dir}:${params.sif_dir}" : ''
    }
    withName: '.*:SIGNALP_RUN' {
        // short_gpu (14 nodes, 2h MaxTime) rather than the general gpu queue
        // (far fewer nodes, heavily contended by other users) -- matches this
        // task's own 2h time limit above, and SignalP GPU inference finishes
        // in under a minute per genome once scheduled (see signalp_run.nf).
        // gpu13/gpu14 (Blackwell6000, sm_120) excluded: confirmed exit 132
        // (SIGILL) on gpu13 -- the container's baked torch/CUDA build predates
        // Blackwell support. Every other short_gpu node (k80/p100/a100/h100/
        // ada6000) is either previously-proven (old gpu partition) or matches
        // the architecture DeepTMHMM's container was built for.
        queue          = params.signalp_gpu ? 'short_gpu' : 'epyc'
        clusterOptions = params.signalp_gpu ? '-N 1 -n 1 --gres=gpu:1 --exclude=gpu13,gpu14' : ''
    }
    withLabel: 'setup'         { container = params.container_setup        }
    withLabel: 'skani'         { container = params.container_skani        }
    withLabel: 'busco_genome'  {
        container = params.container_busco
        // BUSCO needs the host lineage tree (params.busco_lineages) visible
        // inside the image at the same path the process exports as
        // BUSCO_LINEAGES (modules/local/busco_genome.nf).
        containerOptions = "-B ${params.busco_lineages}:${params.busco_lineages}"
    }

    // GENEMARK_RUN does NOT get a process `container =` directive: its script
    // mixes host-run commands (python asm_preflight_stats.py, gzip -- not
    // guaranteed present inside teambraker/braker3) with GeneMark/Augustus-aux
    // commands that must run in the container, so a full-script wrap can't work
    // here the way it does for e.g. the 'funannotate' label above. Instead
    // GENEMARK_RUN builds its own `apptainer exec` invocation for just those
    // commands (see genemark_container_mode below and modules/local/
    // genemark_run.nf) -- ported from BFD's modules/funannotate/predict/
    // GENEMARK_RUN/main.nf, which hit the identical problem first.
    //
    // GeneMark's own license still requires a user-obtained ~/.gm_key even
    // though the image itself is public/redistributable (see
    // params.genemark_path comment in conf/profile_annotate.config) -- gmes_petap.pl
    // reads it from $HOME, and on this cluster ~/.gm_key can be a symlink that
    // resolves outside $HOME/$PWD (e.g. into /opt/linux), so genemark_run.nf
    // resolves and binds its real parent directory at runtime rather than
    // relying on apptainer.autoMounts' plain $HOME bind. (genemark_container_mode
    // itself is set in the params{} block above.)

    // DeepTMHMM: same container for GPU and CPU-only runs — mode is purely a
    // matter of runtime flags (--nv passthrough + a GPU-gres'd queue), not a
    // different image or CLI invocation. Queue/clusterOptions live here (not
    // conf/provision_ucr_hpcc.config, the usual home for UCR queue names)
    // because this tool has no Lmod module and so never runs under
    // -profile ucr_hpcc — see modules/local/deeptmhmm_annotation.nf.
    // Code + weights are baked in at /opt/deeptmhmm (predict.py's cwd, since
    // its model-file loads use paths relative to cwd) -- no runtime bind
    // needed. Output goes to --output-dir instead, so (unlike the old
    // biswasaneel image) no --writable-tmpfs is needed here.
    withLabel: 'deeptmhmm' {
        container        = params.container_deeptmhmm
        containerOptions = params.deeptmhmm_gpu ? '--nv' : ''
    }
    withName: '.*:DEEPTMHMM_ANNOTATION' {
        // Same rationale as SIGNALP_RUN above: short_gpu (14 nodes, 2h
        // MaxTime) matches this task's own 2h time limit and avoids the
        // heavily-contended general gpu queue. Same gpu13/gpu14 (Blackwell)
        // exclusion -- untested against this container's torch/CUDA build;
        // no need to risk the same SIGILL crash confirmed for SIGNALP_RUN.
        queue          = params.deeptmhmm_gpu ? 'short_gpu' : 'epyc'
        clusterOptions = params.deeptmhmm_gpu ? '-N 1 -n 1 --gres=gpu:1 --exclude=gpu13,gpu14' : ''
    }

    // eggNOG-mapper DB bind for funannotate annotate (EGGNOG_DATA_DIR). The host
    // folder from params.eggnog_db is mounted at /opt/databases/eggnog_db inside
    // the image; the image sets EGGNOG_DATA_DIR to that path, so annotate finds
    // eggnog.db etc. without any extra env plumbing here. Appended onto
    // params.funannotate_binds (not a bare assignment) -- this withName selector also
    // matches FUNANNOTATE_ANNOTATE's `label 'funannotate'`, and a withName's
    // containerOptions REPLACES rather than merges with a withLabel's for the
    // same task, so a bare assignment here would silently drop the
    // funannotate_db/proteins/busco_lineages/projectDir binds above.
    withName: '.*:FUNANNOTATE_ANNOTATE' {
        containerOptions = "${params.funannotate_binds} -B ${params.eggnog_db}:/opt/databases/eggnog_db"
    }
}
