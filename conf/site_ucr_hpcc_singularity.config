/*
 * UCR HPCC — additional site overrides for the `singularity` provisioning axis
 * only. Pass this via -c (alongside conf/site_ucr_hpcc.config) for container
 * runs:  -profile annotate,slurm,singularity -c site_ucr_hpcc.config -c site_ucr_hpcc_singularity.config
 *
 * Under the singular axis every 'setup'-labeled process is containerized with
 * the minimal gnu-wget image, which breaks two tasks that genuinely need more:
 *
 * 1. SETUP_MARIADB_DATADIR — its script deliberately runs `apptainer exec`
 *    against params.container_mariadb (mariadb-install-db) as a NATIVE process
 *    (module fallback for the binary, sif on the shared cache). Containerizing
 *    it with gnu-wget nests a container inside a container: no apptainer
 *    binary and no modules inside the image, so it fails with "no
 *    apptainer/singularity binary on PATH". Drop the container: on UCR host
 *    jobs the apptainer binary IS on PATH, and the shared-storage binds come
 *    from the global apptainer.runOptions in site_ucr_hpcc.config.
 *
 * 2. ASM_STATS — top-level ASM_STATS and ANI_REUSE:ASM_STATS. The module no
 *    longer uses seqkit/pigz (pure awk/gzip), but it still needs a container
 *    with coreutils; reuse the AAFTF image (container_genome_clean), which
 *    ships awk and gzip. NOTE: on the Lmod (`ucr_hpcc`) axis this file is not
 *    used, so ASM_STATS stays native there as before.
 */
process {
    withName: '.*:SETUP_MARIADB_DATADIR' { container = false }
    withName: 'ASM_STATS|.*:ASM_STATS'   { container = params.container_genome_clean }
}
