/*
 * UCR HPCC — additional site overrides for the `singularity` provisioning axis
 * only. Pass this via -c (alongside conf/site_ucr_hpcc.config) for container
 * runs:  -profile annotate,slurm,singularity -c site_ucr_hpcc.config -c site_ucr_hpcc_singularity.config
 *
 * Under the singular axis every 'setup'-labeled process is containerized with
 * the minimal gnu-wget image, which breaks a task that genuinely needs more.
 * (SETUP_MARIADB_DATADIR had the same problem; its `container = false` now
 * lives in conf/provision_singularity.config so every site gets it.)
 *
 * ASM_STATS — top-level ASM_STATS and ANI_REUSE:ASM_STATS. The module no
 *    longer uses seqkit/pigz (pure awk/gzip), but it still needs a container
 *    with coreutils; reuse the AAFTF image (container_genome_clean), which
 *    ships awk and gzip. NOTE: on the Lmod (`ucr_hpcc`) axis this file is not
 *    used, so ASM_STATS stays native there as before.
 */
process {
    withName: 'ASM_STATS|.*:ASM_STATS'   { container = params.container_genome_clean }
}

/*
 * The queue= / clusterOptions= rules below normally come from
 * conf/provision_ucr_hpcc.config, which is only included by the `ucr_hpcc`
 * provisioning profile. `singularity`-axis runs don't include it, so without
 * this mirror tasks submit to SLURM's default partition and miss the
 * --export=ALL,SCRATCH=,TMPDIR= guard that keeps FUNANNOTATE_TRAIN/UPDATE's
 * per-task MariaDB datadir on a job-private $SCRATCH (stale inherited values
 * cause the MyISAM temp-table collisions documented in funannotate_train.nf).
 */
process {
    withName: 'SETUP_TAXONDB'         { queue = 'short' }
    withName: 'SETUP_FUNANNOTATE_DB'  { queue = 'epyc'  }
    withName: 'SETUP_AUGUSTUS_CONFIG' { queue = 'short' }

    withName: '.*:GENOME_CLEAN'       { queue = params.skip_fcs ? 'short' : 'highmem'; clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }
    withName: '.*:GENOME_CLEAN_BATCH' { queue = 'highmem'; clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }

    // clusterOptions guard needed here: nodes without squashfuse fall back to
    // fully extracting the .sif into a sandbox under $TMPDIR, which overflows
    // a stale/small inherited TMPDIR (see MASKREPEAT_TANTAN_RUN "No space left
    // on device" failures on v1.9.0-beta10 container cells). Force a fresh
    // job-private $SCRATCH/$TMPDIR, same guard used elsewhere in this file.
    withName: '.*:MASKREPEAT_TANTAN_RUN' { queue = 'short'; clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }
    withName: '.*:EARLGREY_BUILD_LIB'   { queue = 'epyc'  }
    withName: '.*:REPEATMASK_STRAIN'    { queue = 'short' }
    withName: '.*:DELIVER_MASK'         { queue = 'short' }

    withName: '.*:SRA_QUERY_BATCH'    { queue = 'short' }
    withName: '.*:COLLECT_SRA_QUERY'  { queue = 'short' }
    withName: '.*:WRITE_EMPTY_READS'  { queue = 'short' }
    withName: '.*:SRA_FETCH'          { queue = { task.attempt == 1 ? 'short' : 'epyc' }; clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }
    withName: '.*:SRA_FETCH_SE'       { queue = { task.attempt == 1 ? 'short' : 'epyc' }; clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }

    // c01-c30 (abu_dhabi Opteron) lack AVX2/BMI2: Trinity bamsifter, hisat2-build,
    // augustus SIGILL there and funannotate exits 0 with an empty trinity-GG
    // (14 benchmark RNASEQ_PREPARE tasks, 2026-09-24). --exclude is baked in at
    // submit, so it still holds if a pending job is moved to preempt.
    withName: '.*:RNASEQ_PREPARE'     { queue = 'epyc'; clusterOptions = '--export=ALL,SCRATCH=,TMPDIR= --exclude=c[01-30]' }

    withName: '.*:BUSCO_GENOME'            { queue = 'short'; clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }
    withName: '.*:PRODIGAL_RUN'            { clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }
    withName: '.*:SKANI_COMPARE'           { queue = 'epyc'  }
    withName: '.*:CONCAT_ANI_TSVS'         { queue = 'short' }
    withName: '.*:PICK_REPRESENTATIVE_STRAIN' { queue = 'short' }

    withName: '.*:FUNANNOTATE_TRAIN' {
        queue          = { task.attempt <= 2 ? 'epyc' : 'highmem' }
        // --exclude=h[01-06]: Intel Ivy Bridge, no AVX2 -- see the matching
        // FUNANNOTATE_TRAIN block in provision_ucr_hpcc.config for the full
        // rationale (SIGILL crashes on attempt>=3's highmem escalation,
        // discovered 2026-09-11). h07 (Sapphire Rapids, has AVX2) stays
        // available.
        clusterOptions = '-N 1 -n 1 --job-name=nf-TRAIN --export=ALL,SCRATCH=,TMPDIR= --exclude=h[01-06],c[01-30]'
    }
    withName: '.*:FUNANNOTATE_PREDICT_SIB' {
        queue          = 'epyc'
        clusterOptions = '-N 1 -n 1 --job-name=nf-PREDICT-SIB --export=ALL,SCRATCH=,TMPDIR='
    }
    withName: '.*:FUNANNOTATE_PREDICT' {
        queue          = 'epyc'
        clusterOptions = '-N 1 -n 1 --job-name=nf-PREDICT --export=ALL,SCRATCH=,TMPDIR='
    }
    withName: '.*:GENEMARK_RUN_SIB' {
        queue          = 'epyc'
        clusterOptions = '-N 1 -n 1 --job-name=nf-GENEMARK-SIB --export=ALL,SCRATCH=,TMPDIR='
    }
    withName: '.*:GENEMARK_RUN' {
        queue          = 'epyc'
        clusterOptions = '-N 1 -n 1 --job-name=nf-GENEMARK --export=ALL,SCRATCH=,TMPDIR='
    }

    withName: '.*:ANTISMASH_RUN'      { queue = 'epyc';  clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }
    withName: '.*:INTERPROSCAN_RUN'   { queue = 'epyc';  clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }
    withName: '.*:SIGNALP_RUN' {
        queue          = 'gpu'
        clusterOptions = '-N 1 -n 1 --gres=gpu:1 --export=ALL,SCRATCH=,TMPDIR='
    }
    withName: '.*:FUNANNOTATE_ANNOTATE' { queue = 'epyc'; clusterOptions = '--export=ALL,SCRATCH=,TMPDIR=' }
    withName: '.*:FUNANNOTATE_UPDATE'   { queue = 'epyc'; clusterOptions = '-N 1 -n 1 --export=ALL,SCRATCH=,TMPDIR=' }
}
