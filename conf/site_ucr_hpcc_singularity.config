/*
 * UCR HPCC — additional site overrides for the `singularity` provisioning axis
 * only. Pass this via -c (alongside conf/site_ucr_hpcc.config) for container
 * runs:  -profile annotate,slurm,singularity -c site_ucr_hpcc.config -c site_ucr_hpcc_singularity.config
 *
 * Under the singular axis every 'setup'-labeled process is containerized with
 * the minimal gnu-wget image, which breaks two tasks that genuinely need more:
 *
 * 1. SETUP_MARIADB_DATADIR — its script deliberately runs `apptainer exec`
 *    against params.container_mariadb (mariadb-install-db) as a NATIVE process
 *    (module fallback for the binary, sif on the shared cache). Containerizing
 *    it with gnu-wget nests a container inside a container: no apptainer
 *    binary and no modules inside the image, so it fails with "no
 *    apptainer/singularity binary on PATH". Drop the container: on UCR host
 *    jobs the apptainer binary IS on PATH, and the shared-storage binds come
 *    from the global apptainer.runOptions in site_ucr_hpcc.config.
 *
 * 2. ASM_STATS — top-level ASM_STATS and ANI_REUSE:ASM_STATS. The module no
 *    longer uses seqkit/pigz (pure awk/gzip), but it still needs a container
 *    with coreutils; reuse the AAFTF image (container_genome_clean), which
 *    ships awk and gzip. NOTE: on the Lmod (`ucr_hpcc`) axis this file is not
 *    used, so ASM_STATS stays native there as before.
 */
process {
    withName: '.*:SETUP_MARIADB_DATADIR' { container = false }
    withName: 'ASM_STATS|.*:ASM_STATS'   { container = params.container_genome_clean }
}

/*
 * The queue= / clusterOptions= rules below normally come from
 * conf/provision_ucr_hpcc.config, which is only included by the `ucr_hpcc`
 * provisioning profile. `singularity`-axis runs don't include it, so without
 * this mirror tasks submit to SLURM's default partition and miss the
 * --export=ALL,SCRATCH=,TMPDIR= guard that keeps FUNANNOTATE_TRAIN/UPDATE's
 * per-task MariaDB datadir on a job-private $SCRATCH (stale inherited values
 * cause the MyISAM temp-table collisions documented in funannotate_train.nf).
 */
process {
    withName: 'SETUP_TAXONDB'         { queue = 'short' }
    withName: 'SETUP_FUNANNOTATE_DB'  { queue = 'epyc'  }
    withName: 'SETUP_AUGUSTUS_CONFIG' { queue = 'short' }

    withName: '.*:GENOME_CLEAN'       { queue = params.skip_fcs ? 'short' : 'highmem' }
    withName: '.*:GENOME_CLEAN_BATCH' { queue = 'highmem' }

    withName: '.*:MASKREPEAT_TANTAN_RUN' { queue = 'short' }
    withName: '.*:EARLGREY_BUILD_LIB'   { queue = 'epyc'  }
    withName: '.*:REPEATMASK_STRAIN'    { queue = 'short' }
    withName: '.*:DELIVER_MASK'         { queue = 'short' }

    withName: '.*:SRA_QUERY_BATCH'    { queue = 'short' }
    withName: '.*:COLLECT_SRA_QUERY'  { queue = 'short' }
    withName: '.*:WRITE_EMPTY_READS'  { queue = 'short' }
    withName: '.*:SRA_FETCH'          { queue = { task.attempt == 1 ? 'short' : 'epyc' } }
    withName: '.*:SRA_FETCH_SE'       { queue = { task.attempt == 1 ? 'short' : 'epyc' } }

    withName: '.*:RNASEQ_PREPARE'     { queue = 'epyc' }

    withName: '.*:BUSCO_GENOME'            { queue = 'short' }
    withName: '.*:SKANI_COMPARE'           { queue = 'epyc'  }
    withName: '.*:CONCAT_ANI_TSVS'         { queue = 'short' }
    withName: '.*:PICK_REPRESENTATIVE_STRAIN' { queue = 'short' }

    withName: '.*:FUNANNOTATE_TRAIN' {
        queue          = { task.attempt <= 2 ? 'epyc' : 'highmem' }
        clusterOptions = '-N 1 -n 1 --job-name=nf-TRAIN --export=ALL,SCRATCH=,TMPDIR='
    }
    withName: '.*:FUNANNOTATE_PREDICT_SIB' {
        queue          = 'epyc'
        clusterOptions = '-N 1 -n 1 --job-name=nf-PREDICT-SIB'
    }
    withName: '.*:FUNANNOTATE_PREDICT' {
        queue          = 'epyc'
        clusterOptions = '-N 1 -n 1 --job-name=nf-PREDICT'
    }
    withName: '.*:GENEMARK_RUN_SIB' {
        queue          = 'epyc'
        clusterOptions = '-N 1 -n 1 --job-name=nf-GENEMARK-SIB'
    }
    withName: '.*:GENEMARK_RUN' {
        queue          = 'epyc'
        clusterOptions = '-N 1 -n 1 --job-name=nf-GENEMARK'
    }

    withName: '.*:ANTISMASH_RUN'      { queue = 'epyc'  }
    withName: '.*:INTERPROSCAN_RUN'   { queue = 'epyc'  }
    withName: '.*:SIGNALP_RUN' {
        queue          = 'gpu'
        clusterOptions = '-N 1 -n 1 --gres=gpu:1'
    }
    withName: '.*:FUNANNOTATE_ANNOTATE' { queue = 'epyc' }
    withName: '.*:FUNANNOTATE_UPDATE'   { queue = 'epyc'; clusterOptions = '-N 1 -n 1 --export=ALL,SCRATCH=,TMPDIR=' }
}
