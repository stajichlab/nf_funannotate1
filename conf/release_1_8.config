/*
 * 1.8.x release seam — PARAMS ONLY, no code forks.
 *
 * nf_funannotate1 targets funannotate >= 1.9 (stop_after_trinity, sqlite PASA,
 * rust EVM). This fragment repoints the params that differ when running the
 * 1.8.17 line instead, so 1.8 can run from the same main branch:
 *
 *   nextflow run ... -profile annotate,slurm,conda -c conf/release_1_8.config
 *                    --proteins /bigdata/.../swissprot_fungi.faa ...
 *
 * What changes vs 1.9, and why:
 *  - stop_after_trinity=false : `train --stop_after_trinity` did not exist
 *    before 1.9 (train.py rejects it as an unrecognized arg). RNASEQ_PREPARE
 *    then runs the FULL train for the representative and archives its
 *    trinity.fasta as the shared transcriptome; FUNANNOTATE_TRAIN skips the
 *    already-trained representative (see rnaseq_prepare.nf /
 *    funannotate_train.nf).
 *  - conda_env=funannotate-1.8.17 : which frozen conda env to activate under
 *    -profile conda (built once via environments/conda/build_conda_env.sh
 *    into conda_envs_root).
 *  - pasa_mysql=false : the per-task MariaDB path in funannotate_train.nf /
 *    funannotate_update.nf / setup_mariadb_datadir.nf launches a singularity
 *    *instance* regardless of provisioning axis. Under a conda-only site
 *    (no apptainer/singularity), use sqlite PASA instead (--pasa_db sqlite),
 *    which the 1.8.17 env's PASA 2.5.3 supports. Flip to true if
 *    singularity IS available and you need MySQL PASA.
 *  - genemark_container_mode=false (explicit): GeneMark-ES/ET is licensed with
 *    no conda package; under conda it must come from a user-local licensed
 *    install via --genemark_path (there is no `module load genemarkESET` under
 *    -profile conda). Set --run_genemark false to skip GeneMark entirely and
 *    let funannotate predict auto-skip ab-initio.
 *
 * If you are on UCR HPCC and want the Lmod-module 1.8 (module load funannotate)
 * instead of a conda env, swap `conda` for `ucr_hpcc` in the profile list and
 * DO NOT load this fragment's conda_env line (it is ignored under ucr_hpcc).
 */

params {
    stop_after_trinity = false
    conda_env          = 'funannotate-1.8.17'

    // sqlite PASA unless a working apptainer/singularity is guaranteed on the
    // compute nodes (the MariaDB path starts a container *instance*).
    pasa_mysql = false

    // Licensed GeneMark runs host-side under conda. Point at your licensed
    // install, or --run_genemark false to skip it.
    genemark_container_mode = false
    genemark_path           = null
}
