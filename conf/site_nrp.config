/*
 * Site: NRP Nautilus Kubernetes -- what is true for any NRP namespace (pod
 * limits, Ceph S3 endpoint, PVC layout). Loaded by -profile nrp after
 * conf/executor_k8s.config. Your namespace and NRP project are NOT set here:
 * pass them from a small config of your own, kept in your deployment repo
 * (template: k8s/overlays/example/site.config), or as --k8s_namespace /
 * --nrp_project on the command line:
 *
 *   nextflow run stajichlab/nf_funannotate1 -profile annotate,nrp \
 *       -c site.config -params-file k8s/params_nrp_test.yaml
 *
 * Must run INSIDE the cluster, as the Nextflow run Job (k8s/run/job.yaml),
 * from a launch directory on the shared PVC (e.g. /data/runs/<name>): the k8s
 * executor's workDir has to be a ReadWriteMany volume mounted at the same path
 * in the run Job and every task pod, and launchDir-relative outputs
 * (storeDir caches, genome_annotation/, logs/) must land there too.
 *
 * One-time cluster setup: k8s/README.md (kustomize base + your overlay: PVC,
 * RBAC, head Deployment; reference databases).
 */

params {
    // Shared PVC and its mount point in every pod (head + tasks).
    k8s_pvc   = 'funannotate-work-pvc'
    k8s_mount = '/data'

    // Reference databases, staged once onto the PVC (k8s/README.md). The
    // auto-downloadable ones (taxondb, funannotate_db) are created here on
    // first run by their SETUP_* process if absent (storeDir-cached).
    taxondb        = '/data/refdb/taxondb'
    funannotate_db = '/data/refdb/funannotate_db'
    busco_lineages = '/data/refdb/busco_lineages'
    eggnog_db      = '/data/refdb/eggnog_db'
    proteins       = '/data/refdb/swissprot_fungi.faa'
    sbt_template   = '/data/refdb/template.sbt'
    // Shared GeneMark ab-initio parameter store / augustus config stay
    // launchDir-relative (profile_annotate defaults) so each run dir is
    // self-contained; point them under /data/refdb to share across runs.

    // NRP's admission webhook rejects bare pods (no controller, which is what
    // the k8s executor creates) above 16 cores / 32 GB: "PODs without
    // controllers are limited to 16 cores and 32 GB of RAM". Cap every task
    // there, including profile_annotate's retry escalations.
    k8s_max_cpus   = 16
    k8s_max_memory = '32.GB'

    // No GPUs requested on NRP for now (signalp/deeptmhmm are off anyway).
    signalp_gpu   = false
    deeptmhmm_gpu = false
}

k8s {
    namespace        = params.k8s_namespace
    serviceAccount   = 'nextflow-runner'
    storageClaimName = params.k8s_pvc
    storageMountPath = params.k8s_mount
    // NRP usage accounting: annotate every task pod with your NRP project
    // (params.nrp_project, same value as the overlay's commonAnnotations).
    pod = params.nrp_project ? [[annotation: 'nrp-nautilus.io/project', value: params.nrp_project]] : []
}

// NRP fair use for CPU-only work (https://nrp.ai/documentation/userdocs/running/cpu-only/):
// run preemptible (priorityClassName opportunistic; a preempted task fails and
// Nextflow retries it) and keep off GPU nodes (NVIDIA PCI vendor 10de), which
// are about half the cluster. Built once here and used by every task's pod
// directive below: a process-specific `pod` REPLACES the general one, so the
// eggNOG mount on FUNANNOTATE_ANNOTATE has to carry these too.
params.nrp_task_pod = [
    [priorityClassName: 'opportunistic'],
    [affinity: [nodeAffinity: [requiredDuringSchedulingIgnoredDuringExecution: [nodeSelectorTerms: [
        [matchExpressions: [[key: 'feature.node.kubernetes.io/pci-10de.present', operator: 'NotIn', values: ['true']]]]
    ]]]]]
]

process {
    pod = params.nrp_task_pod

    // Re-applied here, after this file's k8s_max_* params: executor_k8s.config
    // builds resourceLimits from them when IT is read, which is before this file
    // sets 16 / 32 GB, so without this the caps stayed at 32 / 128 GB and
    // e.g. SRA_FETCH (24 cpus / 48 GB) was rejected by NRP's webhook.
    resourceLimits = [ cpus: params.k8s_max_cpus as int, memory: params.k8s_max_memory ]

    // funannotate annotate hardcodes EGGNOG_DATA_DIR=/opt/databases/eggnog_db
    // (the image's own default). Under apptainer that path is a -B bind of
    // params.eggnog_db; here it's the same PVC mounted a second time at that
    // path, subPath'd to the eggnog directory.
    withName: '(.*:)?FUNANNOTATE_ANNOTATE' {
        pod = params.nrp_task_pod + [[
            volumeClaim: params.k8s_pvc,
            mountPath  : '/opt/databases/eggnog_db',
            subPath    : (params.eggnog_db as String).replaceFirst("^${params.k8s_mount}/?", ''),
            readOnly   : true
        ]]
    }
}

// Ceph S3 gateway (NRP "West" pool), for s3://<bucket>/... inputs/outputs.
// Credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the run
// Job (Secret nrp-s3-creds); the Nextflow process stages S3 files to/from the PVC
// workDir, so task pods never need credentials.
aws {
    region = 'us-east-1'
    client {
        endpoint          = 'https://s3-west.nrp-nautilus.io'
        s3PathStyleAccess = true
    }
}
