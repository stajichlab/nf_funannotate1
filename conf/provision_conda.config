/*
 * Provisioning: conda environments (4th provisioning axis — -profile conda).
 *
 * Mirrors conf/provision_pixi.config, but activates a conda/mamba env per process
 * label instead of a pixi feature env. Use when you want to run a specific,
 * versioned funannotate install (1.8.17, master, 1.9.0-beta.10, …) from a conda
 * env rather than from a module, pixi feature, or container — including at
 * sites where apptainer/singularity is unavailable.
 *
 * Env manifests live in environments/conda/funannotate-*.yml and are built ONCE
 * (deployment artifacts, like the .sif images — NOT the monorepo pixi.toml,
 * because master/beta install via `pip install git+...` on top of pinned conda
 * deps that one drifty pixi.toml can't express). See environments/conda/README.md.
 *
 * Two envs are used:
 *   conda_env        — the versioned funannotate env (train/predict/annotate/
 *                       update, RNASEQ_PREPARE, augustus setup, GeneMark aux).
 *   conda_env_aux    — a single shared aux env for the peripheral tool labels
 *                       (edirect/sra/genome_clean/skani/busco/antismash/
 *                       interproscan/repeatmask/select). Built once from
 *                       environments/conda/nf_funannotate1-aux.yml.
 *
 * Select the funannotate release at runtime:
 *   -profile annotate,slurm,conda --conda_env funannotate-1.8.17
 * (add -c conf/release_1_8.config to also flip the 1.8-specific params —
 * stop_after_trinity, sqlite PASA, host GeneMark — see that file).
 *
 * Params:
 *   conda_env        name of the funannotate env to activate (subdir of conda_envs_root).
 *   conda_env_aux    name of the shared aux env for the peripheral tool labels.
 *   conda_envs_root  directory the :param:`conda_env` envs live under
 *                    ($HOME/conda/envs-like layout; default shares this user's
 *                    conda envs dir so an existing `funannotate-dev` works too).
 *
 * beforeScripts are double-quoted Groovy strings so ${params.*} resolves at
 * config-parse time; bash command substitution is escaped (\$(...)) so it runs
 * inside the job. The unset-CONDA + source conda.sh idiom matches
 * provision_ucr_hpcc.config and makes nested conda activation reliable in the
 * non-interactive Nextflow job shell.
 *
 * Not conda-solvable, keep the `singularity` (or `ucr_hpcc`) provider for:
 *   - signalp / deeptmhmm : licensed, no conda package (and GPU builds).
 *   - GeneMark-ES/ET      : licensed binary; the 'genemark' label only supplies
 *                           the ET-mode aux tools via conda_env, gmes_petap.pl
 *                           comes from --genemark_path (see below).
 *   - FCS-GX gxdb staging : the 470 GB reference DB lands on /dev/shm per node
 *                           (params.fcs_shm_script) regardless of provider.
 *
 * AAFTF (GENOME_CLEAN's FCS-GX purge) IS conda-solvable from the aaftf channel
 * (stajichlab on anaconda.org, or the local file:// dist-conda build — see
 * environments/conda/nf_funannotate1-aux.yml). It is installed in the shared
 * aux env (conda_env_aux), so the full clean path runs under this axis too;
 * --skip_fcs remains available as the no-AAFTF/lightweight fallback.
 */

params {
    conda_env       = 'funannotate-1.8.17'
    conda_env_aux   = 'nf_funannotate1-aux'
    // Directory of pre-built (frozen) conda envs, one per funannotate release.
    // Built once into shared, node-visible storage via
    // environments/conda/build_conda_env.sh. Resolved like params.sif_dir:
    // $CONDA_ENVS_ROOT if set (site sysadmins export it in the launcher /
    // module env — on UCR HPCC that is /bigdata/stajichlab/shared/condaenv,
    // readable by every SLURM node), else a per-user dir under $HOME/.conda —
    // which keeps the conda axis zero-config on a workstation (a pre-existing
    // `funannotate-dev` there works via --conda_envs_root too). Do NOT stick an
    // override in conf/site_ucr_hpcc.config: ucr_hpcc and conda are mutually
    // exclusive provisioning axes, so that file is never loaded on a conda run —
    // the env var (or a --conda_envs_root CLI flag) is the only live lever.
    conda_envs_root = System.getenv('CONDA_ENVS_ROOT') ?: "${System.getenv('HOME') ?: '/tmp'}/.conda/nf_funannotate1"
}

// Resolve the absolute env prefixes once, used by every label's beforeScript.
params.conda_env_prefix     = "${params.conda_envs_root}/${params.conda_env}"
params.conda_env_aux_prefix = "${params.conda_envs_root}/${params.conda_env_aux}"

// Shared activation preamble: source Lmod + miniconda3, clear stale CONDA_*,
// then `conda activate <prefix>`. Kept minimal per label below (Nextflow has no
// config-level string concat helper here; the block is small enough to repeat).
process {
    // ── funannotate core: train/predict/annotate/update, RNASEQ_PREPARE,
    //    SETUP_AUGUSTUS_CONFIG, SETUP_FUNANNOTATE_DB, MASKREPEAT_TANTAN_RUN ──
    withLabel: 'funannotate' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_prefix}"
        """
    }

    // ── GeneMark-ES/ET is licensed and has NO conda package: this label only
    //    supplies ET-mode aux tools (bam2hints, join_mult_hints.pl) and perl
    //    deps from conda_env. gmes_petap.pl itself must come from a user-local
    //    licensed install pointed at via params.genemark_path (set
    //    genemark_container_mode = false, then --genemark_path
    //    /path/to/gmes_petap_dir). Mirrors provision_pixi.config's 'genemark'.
    withLabel: 'genemark' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_prefix}"
        """
    }

    // ── Peripheral tool labels: shared aux env (conda_env_aux) ───────────────
    withLabel: 'edirect' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'sra' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'genome_clean' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'skani' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'busco_genome' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    // Prodigal (PRODIGAL_RUN): conda-solvable (bioconda `prodigal`), supplied by
    // the shared aux env (see prodigal in environments/conda/nf_funannotate1-aux.yml).
    withLabel: 'prodigal' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'antismash' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'interproscan' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'repeatmask' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'earlgrey' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }
    withLabel: 'select' {
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3 2>/dev/null || true
            unset CONDA_SHLVL CONDA_PREFIX CONDA_PREFIX_1 CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER
            source "\${CONDA_ROOT:-\$(conda info --base)}/etc/profile.d/conda.sh"
            conda activate "${params.conda_env_aux_prefix}"
        """
    }

    // ── Base system tools only — no env needed ───────────────────────────────
    withLabel: 'setup'   { beforeScript = ':' }
    withLabel: 'deliver' { beforeScript = ':' }

    // ── NOT conda-solvable (licensed / GPU / FCS-GX): refuse loudly rather than
    //    let the task run with a bare login shell and fail with a confusing
    //    "command not found" hours in. Keep -profile singularity for these. ────
    withLabel: 'signalp' {
        beforeScript = """
            echo "ERROR: SignalP has no conda package; run the signalp label under -profile singularity (container_signalp) instead" >&2
            exit 1
        """
    }
    withLabel: 'deeptmhmm' {
        beforeScript = """
            echo "ERROR: DeepTMHMM is licensed with no conda package; run the deeptmhmm label under -profile singularity (container_deeptmhmm) instead" >&2
            exit 1
        """
    }
}
