/*
 * Site overrides template — fill in YOUR institution's shared paths.
 *
 * conf/profile_annotate.config sets portable, launchDir-relative defaults for
 * every reference-database and config path so the pipeline runs at any site
 * out of the box: things the pipeline can auto-download (taxonkit taxdump via
 * SETUP_TAXONDB, funannotate DBs via SETUP_FUNANNOTATE_DB, antiSMASH DBs via
 * SETUP_ANTISMASH_DB, BUSCO lineages) land under launchDir on first run and
 * are storeDir-cached; things it can NOT download (eggNOG DB, PASA config,
 * SwissProt proteins, a GeneMark license) use a launchDir placeholder and must
 * be supplied by the site.
 *
 * Use this file to repoint those defaults at your site's existing shared
 * installs so every project reuses them instead of re-downloading / requiring
 * per-project population.
 *
 * How to use:
 *   1. cp conf/site_template.config conf/site_<site>.config
 *   2. Set the params below to your site's paths (leave commented out what you
 *      don't have — the portable default then applies).
 *   3. Pass it on every run with `-c conf/site_<site>.config`, or includeConfig
 *      it from a site provisioning profile in nextflow.config for a
 *      `-profile ...,<site>` shorthand (UCR does this via `ucr_hpcc` and
 *      conf/site_ucr_hpcc.config — see that file for a filled-in example).
 *
 * NOTE: this file is a params template only — it contains NO tool loading.
 * Tool provisioning is chosen by the provisioning profile axis (see
 * README "Running at another site"): `singularity` (containers) and `pixi`
 * (project-local envs) are portable anywhere; `ucr_hpcc` (Lmod modules) is
 * institutional.
 */

params {

    // ── Container/SIF cache (singularity provisioning axis) ───────────────────
    // Directory holding .sif images and doubling as the apptainer pull cache.
    // By default resolved from NXF_APPTAINER_CACHE → NXF_SINGULARITY_CACHE →
    // APPTAINER_CACHE (see nextflow.config). Set it explicitly here to pin a
    // site-shared cache for everyone:
    // sif_dir = "/shared/lib/singularity_cache"

    // ── Conda env root (conda provisioning axis) ──────────────────────────────
    // Directory of pre-built (frozen) conda envs, one per funannotate release,
    // built once with environments/conda/build_conda_env.sh into shared,
    // compute-node-visible storage. Resolved from $CONDA_ENVS_ROOT (export it
    // in the shared module/env setup — the recommended way to point the whole
    // site at one shared build), else a per-user $HOME/.conda/nf_funannotate1.
    // A --conda_envs_root CLI override always wins. NOTE: this file is only
    // loaded under the `ucr_hpcc` (module) provisioning profile, which never
    // uses conda envs, so the env var is the right lever here, not a params
    // entry in this file.
    // conda_envs_root = "/shared/lib/condaenv"

    // ── Assembly source (pipeline `annotate` axis) ────────────────────────────
    // NCBI_ASM source dir; genomes resolve as <source>/<ASMID>/<ASMID>_genomic.fna.gz
    // for samples.csv rows without a GENOME column.
    // source = "/shared/projects/NCBI_fungi/source/NCBI_ASM"

    // ── Reference databases (auto-downloaded otherwise, storeDir-cached) ──────
    // taxonkit/NCBI taxdump (or SETUP_TAXONDB downloads it).
    // taxondb = "/shared/lib/taxa"
    // funannotate databases — point at a prebuilt shared res dir to skip SETUP_FUNANNOTATE_DB.
    // funannotate_db = "/shared/lib/funannotate_db"
    // antiSMASH databases — point at a prebuilt shared dir to skip SETUP_ANTISMASH_DB.
    // antismash_db = "/shared/lib/antismash_db"
    // BUSCO v10-format lineage tree.
    // busco_lineages = "/shared/lib/busco/v10/"

    // ── Reference databases (NOT auto-downloaded — site must supply) ──────────
    // eggNOG-mapper DB (eggnog.db, eggnog_proteins.dmnd, eggnog.taxa.db).
    // eggnog_db = "/shared/lib/eggNOG/LATEST"
    // SwissProt fungi protein evidence FASTA.
    // proteins = "/shared/lib/swissprot_fungi.faa"
    // PASA config templates (my.cnf + conf.txt) for the mysql backend.
    // pasa_conf_dir = "/shared/lib/pasa_conf/"

    // ── Licensed tools / GPU availability ─────────────────────────────────────
    // Host GeneMark-ES/ET installation (gmes_petap.pl) to use when NOT running
    // the braker3-container mode (singularity axis with genemark_container_mode=true).
    // The user's gm_key must be in $HOME/.gm_key regardless of which mode runs.
    // genemark_path = "/shared/install/genemark/gmes_petap.pl"
    // SignalP 6 / DeepTMHMM are licensed images (signalp6-fast.sif,
    // DeepTMHMM-1.0.sif). Keep the GPU flags on only if your scheduler offers
    // GPU nodes; the same image/command works CPU-only with these off.
    // signalp_gpu   = true
    // deeptmhmm_gpu = true
}
