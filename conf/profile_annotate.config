/*
 * annotate pipeline profile: funannotate.nf
 *
 * Provides the pipeline params and per-process SLURM resources. Combine with an
 * executor profile (slurm|local) and a provisioning profile (ucr_hpcc|pixi|
 * singularity), e.g.  -profile annotate,slurm,ucr_hpcc
 *
 * Defaults are fungal (busco fungi via BUSCO_LINEAGE column, antismash_taxon=fungi,
 * swissprot_fungi proteins) but every organism-specific value is a param, so other
 * eukaryotes work by override (e.g. --antismash_taxon plants, a different
 * --proteins file, BUSCO_LINEAGE column per row).
 *
 * Adapted from BFD/Fungi_BFD/nextflow/conf/profile_funannotate.config.
 * Change vs source: node-pinning (-w h04,h05,h06) dropped; queues use the skill's
 * partition rules; FUNANNOTATE_TRAIN/SIGNALP queues made explicit.
 */

params {
    // ── inputs / outputs ──────────────────────────────────────────────────────
    target               = "${launchDir}/genome_annotation"
    training_target      = "${launchDir}/genome_annotation_training"
    // NCBI_ASM source dir: genomes resolved as <source>/<ASMID>/<ASMID>_genomic.fna.gz
    // (used only for rows without a GENOME column — see funannotate.nf dual input).
    // Portable placeholder; UCR HPCC overrides to the shared 1KFG staging dir
    // (conf/site_ucr_hpcc.config, loaded by -profile ucr_hpcc).
    source               = "${launchDir}/source"
    // Local taxonkit/NCBI taxdump, auto-downloaded by SETUP_TAXONDB
    // (storeDir-cached -- see modules/local/setup_taxondb.nf). Portable default
    // just caches it under launchDir/work; UCR HPCC overrides to a shared
    // download so it isn't re-fetched per project (conf/site_ucr_hpcc.config).
    taxondb              = "${launchDir}/work/taxondb"
    proteins             = "${launchDir}/lib/swissprot_fungi.faa"
    seqcenter            = "NCBI"

    // ── assembly statistics (for earlgrey_mask.nf SELECT_REPS) ────────────────
    tables_dir           = "${launchDir}/tables"
    gen_asm_stats        = true  // generate asm_stats.tsv.gz from clean genomes
    // Directory ASM_STATS scans for cleaned genomes — the storeDir target that
    // GENOME_CLEAN writes <asmid>.fa into. Must match earlgrey_mask.nf's
    // params.genome_dir so both pipelines read the same cleaned assemblies.
    genome_dir           = "${launchDir}/input_clean_genomes"
    // Writable AUGUSTUS_CONFIG copy, seeded once by SETUP_AUGUSTUS_CONFIG (storeDir-cached).
    // augustus writes new species parameter sets here during training, so it must be a
    // private writable copy of the install's read-only config.
    augustus_config      = "${launchDir}/lib/augustus/3.5/config"
    // Source augustus config to copy from. null = autodetect (AUGUSTUS_CONFIG_PATH from the
    // provisioning env, else ../config from the augustus binary). Override to a specific path
    // to force the seed source.
    augustus_config_source = null
    // Local funannotate database, built once by SETUP_FUNANNOTATE_DB (storeDir-cached).
    // Override to a prebuilt shared DB (e.g. /bigdata/stajichlab/shared/lib/funannotate_db)
    // to skip the build — SETUP_FUNANNOTATE_DB no-ops when this directory already exists.
    funannotate_db       = "${launchDir}/funannotate_db"
    // eggNOG-mapper database (EGGNOG_DATA_DIR) used by funannotate annotate.
    // Bound into the funannotate container as /opt/databases/eggnog_db (see
    // conf/provision_singularity.config). Contains eggnog.db / eggnog_proteins.dmnd
    // / eggnog.taxa.db. Not auto-downloaded by this pipeline -- populate it
    // yourself before --run_annotate. Portable placeholder; UCR HPCC overrides
    // to the shared install (conf/site_ucr_hpcc.config).
    eggnog_db            = "${launchDir}/eggnog_db"
    sbt_template         = "${launchDir}/lib/template.sbt"

    // ── genome cleaning / masking ─────────────────────────────────────────────
    min_contig_len       = 2000
    clean_script         = "${projectDir}/bin/clean_genome_fa.py"
    fcs_shm_script       = "${projectDir}/bin/setup_fcs_shm.sh"
    // skip_fcs=true bypasses the AAFTF FCS-GX contaminant purge in GENOME_CLEAN
    // (no 470 GB gxdb / highmem needed) — just length-filters the assembly.
    skip_fcs             = false
    // clean_batch_size > 0 batches that many genomes into a single SLURM job that stages
    // the FCS-GX db into /dev/shm once (GENOME_CLEAN_BATCH), amortizing the ~30-min stage.
    // 0 (or skip_fcs) falls back to one SLURM job per genome (GENOME_CLEAN).
    clean_batch_size     = 1000
    run_repeatmasker     = true
    // EarlGrey TE-discovery masking (alternative to tantan via run_repeatmasker).
    // run_earlgrey takes precedence over run_repeatmasker when both are true.
    // Requires -profile annotate,earlgrey (or earlgrey labels defined in your config).
    run_earlgrey         = false
    earlgrey_outdir      = "${launchDir}/results/repeatlibrary"
    earlgrey_workdir     = "${launchDir}/work/earlgrey_persist"
    earlgrey_version     = '7.2.6'
    repeatmasker_version = '4.1.8'
    repeat_taxon         = 'fungi'
    masked_dir           = "${launchDir}/input_clean_genomes"
    only_clean           = false

    // ── RNA-seq / SRA ─────────────────────────────────────────────────────────
    rnaseq_data          = "${launchDir}/rnaseq_data"
    // Rust helpers built by scripts/build_tools.sh into tools/bin/ (NOT committed).
    fastq_hdr_script     = "${projectDir}/tools/bin/fix_fastq_header_trinity"
    readlen_script       = "${projectDir}/tools/bin/enforce_seqpair_readlen"
    run_sra_fetch        = true
    skip_sra_query       = false
    stop_after_sra_query = false
    stop_after_sra_fetch = false
    sra_query_batch_size = 10
    max_rnaseq_runs      = 2
    max_rnaseq_spot      = 0
    max_rnaseq_reads     = 40000000
    enable_single_end    = false
    max_rnaseq_se_runs   = 3
    rnaseq_trimmer       = "fastp"
    // funannotate train --stop_after_trinity lets RNASEQ_PREPARE emit the shared
    // Trinity-GG transcriptome for the representative WITHOUT running PASA, then
    // FUNANNOTATE_TRAIN aligns transcripts for every strain via --trinity.
    // This flag did not exist until funannotate 1.9; the 1.8.x line's train.py
    // accepts --trinity but rejects --stop_after_trinity (unrecognized argument).
    // When running older funannotate releases (e.g. conda-env funannotate-1.8.17)
    // set stop_after_trinity=false: RNASEQ_PREPARE then runs the FULL train for
    // the representative (persisting into training_target) and ARCHIVES its
    // trinity.fasta as the shared transcriptome — the representative is trained
    // once, not twice, because FUNANNOTATE_TRAIN sees the existing train output
    // and skips (see modules/local/rnaseq_prepare.nf + funannotate_train.nf).
    stop_after_trinity   = true

    // ── prediction / training ─────────────────────────────────────────────────
    max_cpus             = 64
    max_intronlen        = 3000
    min_intronlen        = 10

    // FUNANNOTATE_TRAIN pre-flight guard: a shared Trinity-GG assembly with fewer
    // than this many transcripts is skipped outright (ab-initio-only) rather than
    // handed to PASA -- too thin to mean anything, usually the wrong reference
    // strain. Set to 0 to disable. Ported from BFD/Fungi_BFD_runs's
    // conf/profile_funannotate.config.
    train_min_trinity_transcripts = 2000
    // PASA training-set gate for funannotate predict (--min_pasa_complete_models):
    // Augustus/SNAP train from PASA only with at least this many complete-ORF PASA
    // models, else from BUSCO; RNA-seq stays evidence. 1000 from experiment C
    // (funannotate docs/assessment_pasa2.6_fun1.9/README.md section 6): genomes with
    // 482-976 complete models lost 6.6-18.2 holdout locus F1 with PASA training.
    // Passed only if the container's funannotate predict knows the flag (>= 1.9.0-rc.2);
    // rc.1 has no gate. null = do not pass it (funannotate's own default).
    predict_min_pasa_complete_models = 1000
    // Short-transcript Trinity guard: if the median transcript length of the Trinity
    // assembly train used is below this (bp), FUNANNOTATE_TRAIN writes
    // training/.trinity_short_transcripts and FUNANNOTATE_PREDICT trains from BUSCO
    // (needs >= rc.2; RNA-seq kept as evidence). BFD wave 1 triage: median < 800 bp ->
    // 138 of 171 PASA sets had < 25% complete models; >= 800 bp -> 2 of 2,974.
    // 0 disables. Ported from BFD/Fungi_BFD (gates/pasa1000-trinity-median).
    train_min_trinity_median_len = 800
    // EVM weights (2026-09-30; BFD pasa_train_performance_evaluate/DECISIONS.md
    // D126/D127). Appended to predict's single -w group after codingquarry:0
    // glimmerhmm:0 genemark:1 (last value wins); not used when Prodigal evidence
    // (other_gff) is passed; repeat-aware snap:0 still overrides snap.
    // funannotate's built-in weights are augustus:1 hiq:2 genemark:1 snap:1 pasa:6;
    // '' = keep them. With a PASA training set: +3.8 to +4.4 holdout F1 on 38
    // held-out RefSeq genomes, worse in 0 of 76 genome-arms. Without RNA-seq:
    // +9.5 F1, better in 15 of 15 (EVM-only reruns). Ported from BFD/Fungi_BFD
    // (gates/evm-weights-refit).
    predict_evm_weights       = 'augustus:1 hiq:3 genemark:2 snap:1 pasa:4'
    predict_evm_weights_norna = 'augustus:2 hiq:5 genemark:4 snap:1'
    // PASA speed/input options (funannotate >= 1.9.0-rc.4; passed only when the
    // container supports them). Benchmark: BFD pasa_train_performance_evaluate/pasa_speed (D128).
    train_pasa_alt_splice       = false   // PASA --ALT_SPLICE; reports unused by train/predict/update
    train_pasa_remove_contained = 'off'   // off | strict | introns
    train_pasa_max_isoforms     = 0       // keep top-N isoforms per Trinity gene; 0 = all
    // Cache PASA's full-length (complete ORF) list next to the shared Trinity assembly
    // (<assembly>.pasa_fl_accs, md5-checked) when that folder is writable.
    train_pasa_fl_cache         = true
    // Remove funannotate-train intermediates predict never reads (getBestModel/,
    // the GMAP index, seqclean copies of Trinity, pasa.step1.gff3; also pasa/
    // when run_update is off) once a genome's training resolves, and after its
    // predict succeeds (covers genomes trained earlier). ~1.5 of 1.7 GB per
    // genome on Bd with run_update off. See bin/train_cleanup.sh.
    train_cleanup = false
    // Minimum TOTAL compressed bytes across r1+r2+se before funannotate train is
    // attempted at all. 0 disables. Guards against a dead or far-too-shallow
    // library burning hours in hisat2/Trinity and then silently producing a junk
    // Augustus training set.
    //
    // Calibration (2026-09-19, BFD/Funannotate_benchmarking, 9 genomes):
    //   trained cleanly : 147 MB - 1020 MB compressed  (4.2M - 6.2M mapped reads)
    //   failed          : 0 bytes (Rhodotorula_toruloides, no reads at all)
    //                     13.8 MB single-end (Malassezia_globosa, 185k mapped
    //                     reads -> 507 transcripts -> 4x gene undercall)
    // 50 MB sits ~3x above the worst failure and ~3x below the weakest success.
    // NOTE: there are NO observations between 13.8 MB and 147 MB, so this value
    // is a judgement call inside a 10x blind spot, not a measured optimum.
    // Revisit once the 15-genome set populates the middle of that range.
    // Explicit PASA aligner list for `funannotate train --aligners` (space-separated,
    // e.g. 'gmap' or 'minimap2 blat'). null = historical per-version default.
    pasa_aligners        = null
    train_min_rnaseq_bytes = 50000000

    // FUNANNOTATE_TRAIN's pasa_tier: relaxes PASA's alignment identity/coverage
    // thresholds for shared-Trinity (cross-strain) training, keyed on how close
    // the training assembly is to the species' RNA-seq/representative anchor.
    // 'stringent' (PASA's own defaults, untouched) is the only tier this pipeline
    // currently ever assigns -- see the "Not ported yet" note in
    // subworkflows/local/train_predict.nf: nf_funannotate1 has no ANI-driven
    // representative/sibling distance computation or hybrid-cross composite
    // Trinity building (BFD/Fungi_BFD_runs's FUNANNOTATE_RNASEQ.nf), so
    // 'relaxed'/'composite'/'composite_fallback' can never be reached here yet.
    // The threshold values themselves and the branch structure are ported now so
    // the module is ready to receive a real tier once that upstream work lands.
    pasa_shared_min_avg_per_id   = 85
    pasa_shared_min_pct_aligned  = 70
    pasa_shared_num_bp_splice    = 1
    pasa_composite_min_avg_per_id  = 85
    pasa_composite_min_pct_aligned = 60
    pasa_composite_num_bp_splice   = 1
    pasa_composite_fallback_min_avg_per_id  = 70
    pasa_composite_fallback_min_pct_aligned = 55
    pasa_composite_fallback_num_bp_splice   = 1
    // FUNANNOTATE_PREDICT / GENEMARK_RUN pre-flight guard (bin/asm_preflight_stats.py).
    // Any verdict other than "ok" skips the genome, and the skip is recorded in
    // ${target}/predict_skipped_too_small.tsv. The one exception: a small_fragmented
    // genome that has PRODIGAL_RUN evidence (other_gff) still runs predict.
    // Verdicts: small_fragmented (small AND fragmented: cannot yield the 30 training
    // models); no_training_contigs (no contig reaches GeneMark-ES's 10 kb training cutoff,
    // at any total size); too_small (below an absolute floor, fragmented or not).
    // Thresholds are BFD's (Fungi_BFD nextflow/conf/profile_funannotate.config), so an
    // nf_funannotate1 run skips the same genomes the BFD pipeline does.
    // Set predict_min_asm_bp = 0 to disable the small_fragmented gate.
    predict_min_asm_bp       = 9000000    // assembled bp below this = "small"
    predict_frag_max_n50     = 15000      // N50 below this = "fragmented"
    predict_frag_max_contigs = 1000       // contig count above this = "fragmented"
    predict_abs_min_asm_bp   = 100000     // assembled bp below this = "too_small" (0 disables)
    predict_min_training_contig_len = 10000  // GeneMark-ES/ET's own --min_contig cutoff (0 disables)
    predict_min_training_contigs    = 1      // contigs >= that length required (0 disables)

    // Repeat-aware EVM (BFD rule): when the soft-masked share of the genome is at or
    // above predict_evm_repeat_pct_threshold, predict passes --repeats2evm
    // --evm-partition-interval <interval>, and (drop_snap) -w snap:0. Measured on the
    // Rust EVM engine against Austropuccinia psidii (65% masked) and GCA_003724095.1,
    // whose EVM step failed without it. 0 disables.
    predict_evm_repeat_pct_threshold   = 60
    predict_evm_repeat_aware_interval  = 1500   // funannotate's default interval
    predict_evm_repeat_aware_drop_snap = true

    // Rewrite each genome FASTA defline to its first word before predict (funannotate
    // rejects deflines longer than --header_length). BFD does not do this; BFD masked
    // FASTAs have single-word deflines, so the rewrite is a no-op there (checked on the
    // 48 genomes of NRP block 01). Set false to pass deflines through unchanged.
    predict_defline_first_word = true

    // GeneMark-ES/ET (licensed, host-side only — see GENEMARK_RUN module doc).
    // genemark_mode: 'auto' (ES, or ET when a training BAM is available) | 'ES' | 'ET'
    genemark_mode        = 'auto'
    // run_genemark = false: skip the standalone GeneMark step entirely and let
    // funannotate predict fall back to --auto-skip-genemark (no ab-initio models).
    run_genemark         = true
    // genemark_sidecar_dir: when set, TRAIN_PREDICT does not run GENEMARK_RUN
    // in this pipeline invocation at all -- it looks up
    // <genemark_sidecar_dir>/<out>.genemark.gtf per genome instead (produced
    // once, out of band, by genemark_sidecar.nf). For comparing multiple
    // funannotate versions/environments against the SAME genome set where
    // GeneMark itself should be held constant and not re-run per comparison
    // cell. Unset (default) = normal per-run GENEMARK_RUN behavior.
    genemark_sidecar_dir = null
    // Prodigal ab-initio pass-through (PRODIGAL_RUN -> funannotate predict
    // --other_gff <gff>:<weight>, EVM source 'other_pred1'). Enabled for
    // short-ORF/intron-poor special cases (microsporidia; Saccharomycotina
    // follow-up) where Augustus/GeneMark recover too few training genes.
    // prodigal_weight: EVM weight for prodigal models (default 5; --
    // StartWeights['other_pred1']). Calibrated 2026-08-31 on the OC4 held-out
    // microsporidia gold genome against the hierarchy fix (gene Sn/Sp
    // 0.839/0.817 vs 0.849/0.791 Prodigal-alone -- Prodigal-level recall with
    // better precision; weight 1 never benchmarked with the fix).
    // prodigal_mode: 'single' (complete genomes) | 'meta' (fragmented/short
    // contigs, biases ORF recovery over single-genome training quality).
    run_prodigal        = false
    prodigal_weight     = 5
    prodigal_mode       = 'single'
    // Contingency: restrict PRODIGAL_RUN to genomes whose BUSCO lineage matches
    // this list (e.g. ['microsporidia_odb10'] to apply the prodigal hierarchy
    // fix only to microsporidia and leave every other phylum on Augustus/
    // GeneMark alone). Empty list = run prodigal for every genome whenever
    // run_prodigal is true.
    prodigal_lineages   = []
    // User-local licensed GeneMark install dir containing gmes_petap.pl. null = rely
    // on $GENEMARK_PATH (set by `module load genemarkESET` on UCR HPCC) or PATH.
    // Mandatory under pixi provisioning (no module, no container there). NOT used
    // under singularity provisioning -- genemark_container_mode below runs
    // gmes_petap.pl/bam2hints/join_mult_hints.pl from params.container_genemark
    // instead (see GENEMARK_RUN in modules/local/genemark_run.nf and BFD's
    // GENEMARK_RUN_DESIGN.md "Update (2026-08-18)": the public
    // teambraker/braker3 image is redistributable and needs no separate build,
    // but GeneMark's own license still requires a user-obtained ~/.gm_key
    // regardless of which image runs it -- the public image only ships the
    // binary, it does not grant a license).
    genemark_path        = null
    // true under -profile singularity (set in conf/provision_singularity.config):
    // GENEMARK_RUN builds an `apptainer exec` invocation itself for just the
    // GeneMark/Augustus-aux commands (gmes_petap.pl, bam2hints,
    // join_mult_hints.pl) instead of relying on a host install or a full-script
    // container wrap -- the rest of that process's script (python preflight
    // check, gzip) still runs on the bare host shell, mirroring BFD's approach
    // (ported from BFD nextflow/modules/funannotate/predict/GENEMARK_RUN/main.nf).
    genemark_container_mode = false
    // force_independent = true: ignore any shared/reused model and do a fresh
    // GeneMark ES/ET self-training for every assembly (never --predict_with).
    force_independent    = false
    // Shared per-species ab-initio parameter store (parameters.json + *.genemark.mod)
    // populated by BACKFILL_ABINITIO_PARAMS and consumed by GENEMARK_RUN (--predict_with)
    // and ANI-based fast-reuse. '' = disabled (every assembly trains independently).
    gene_prediction_shared_abinitio = ''
    // ANI threshold (° similarity) for picking representative strains for ab-initio reuse.
    ani_reuse_threshold  = 99.0

    // ── ANI-driven representative-strain ab-initio reuse (in-run front-end) ────
    // run_ani_reuse = true: the ANI_REUSE front-end runs inside this workflow —
    // BUSCO genome completeness + skani all-vs-all ANI + PICK_REPRESENTATIVE_STRAIN —
    // and prediction is gated on per-species representatives (full port of BFD
    // FUNANNOTATE_PREDICTION: reps train fresh + backfill; eligible siblings fast-
    // reuse the species' shared GeneMark .mod only when it's available; independents
    // train solo; blocked siblings land in predict_blocked_awaiting_representative.tsv
    // unless allow_independent_fallback).
    run_ani_reuse           = false
    ani_outdir              = "${launchDir}/results/ani"
    ani_method              = 'skani'   // skani | mash | sourmash | fastani
    compare                 = 'SPECIES' // ANI comparison group (in-run groups per species)
    skani_preset            = 'medium'  // fast | medium | slow
    skani_min_af            = 15        // minimum aligned fraction (%) to report a pair
    skani_compression       = 0         // -c override; 0 = use preset default
    // BUSCO lineages for BUSCO_GENOME and BUSCO_COMPLETENESS: the directory that
    // holds the lineage dirs (<busco_lineages>/<lineage>_odb10). A parent with
    // a lineages/ subdir (BUSCO's --download_path layout) also works for
    // BUSCO_GENOME, but BUSCO_COMPLETENESS needs the lineage dirs directly.
    // v10, not v12: funannotate predict's own internal ab-initio BUSCO training
    // step (vendored funannotate-BUSCO2.py) requires the legacy v2/v3-format
    // lineage files (lengths_cutoff) that v12 datasets don't ship -- confirmed
    // by direct failure ("Impossible to read the lengths in .../lengths_cutoff")
    // -- so the same BUSCO_LINEAGE value used by both this (standalone busco
    // genome-mode, for ANI reuse completeness scoring) and funannotate predict
    // must be a v10-format lineage. busco 6.1.0 reads v10-format datasets fine.
    // Not auto-downloaded by this pipeline -- populate it yourself (`busco
    // --download`) or override --busco_lineages. Portable placeholder; UCR
    // HPCC overrides to the shared v10 tree (conf/site_ucr_hpcc.config).
    busco_lineages          = "${launchDir}/busco_lineages"
    // BUSCO_COMPLETENESS (modules/local/busco_completeness.nf): completeness of
    // funannotate predict's FINAL delivered gene set, always run via this
    // container regardless of provisioning axis (apptainer.enabled is on
    // unconditionally below, not just under -profile singularity) so BUSCO's
    // own version/environment is held constant across every benchmark cell.
    container_busco_completeness = 'docker://ezlabgva/busco:v6.1.0_cv3'
    genome_stats_outdir     = "${launchDir}/results/genome_stats"
    // predict_scope: 'all' (currently the only honored value) — predict every strain
    // with representative gating. 'representative_only' from BFD is not ported.
    predict_scope           = 'all'
    // When a species' shared ab-initio store is unavailable, its eligible siblings are
    // excluded from prediction and reported; true instead lets them train independently.
    allow_independent_fallback = false

    // ── PASA mysql (mariadb singularity service used by train/update) ──────────
    pasa_mysql           = true
    // Always invoked directly via `apptainer exec` (funannotate_train.nf /
    // funannotate_update.nf / setup_mariadb_datadir.nf), independent of the
    // provisioning axis -- unlike the tool containers in
    // conf/provision_singularity.config, this isn't gated by -profile
    // singularity. null (default) = use params.container_funannotate: the
    // funannotate image bundles MariaDB (mariadbd 11.8.6, mariadb-install-db,
    // /usr/bin/mysqld_safe in 1.9.0-rc.1), so no separate mariadb.sif is
    // needed. Override with --container_mariadb <path.sif|docker://uri> (the
    // old UCR image: /bigdata/stajichlab/shared/lib/singularity_cache/mariadb.sif,
    // MariaDB 10.3.9). A docker:// URI resolves to Nextflow's cache file under
    // params.sif_dir and is pulled at most once (FunannotateUtils.localImageFile).
    container_mariadb    = null
    // Seed MariaDB datadir (the 'mysql' system-schema folder is rsync'd out of
    // it into each task's private scratch datadir -- see funannotate_train.nf /
    // funannotate_update.nf). Auto-built once by SETUP_MARIADB_DATADIR
    // (storeDir-cached, runs mariadb-install-db inside params.container_mariadb
    // -- see modules/local/setup_mariadb_datadir.nf), so no manual pre-init or
    // personal path is needed at any site.
    mysql_datadir        = "${launchDir}/work/mysql_datadir"
    // true: SETUP_MARIADB_DATADIR already runs inside the MariaDB image and calls
    // mariadb-install-db directly (no nested apptainer). Set by conf/executor_k8s.config.
    mariadb_setup_in_image = false
    // true: FUNANNOTATE_PREDICT runs `funannotate predict -o` in node-local
    // \$TMPDIR (\$SCRATCH, else /tmp) and copies only the final pruned tree to
    // params.target -- BUSCO/Augustus training writes thousands of small files,
    // which is very slow on network filesystems (CephFS). Set by the k8s profile.
    predict_local_scratch = false
    // true: GENEMARK_RUN runs gmes_petap.pl in node-local \$TMPDIR (else /tmp) and copies only the
    // .gtf, .mod and stdout log back -- GeneMark-ES/ET writes ~2,400 files (740 MB) per genome in
    // its working directory, slow on network filesystems and left behind in work/. Set by the k8s profile.
    genemark_local_scratch = false
    // PASA config templates (my.cnf + conf.txt), vendored in-repo -- not a
    // personal ~/.pasa/pasa_conf/ path (PASA itself has no requirement to
    // read config from $HOME/.pasa; confirmed 2026-09-09 against Fungi_BFD's
    // identical fix). Keeping these under version control means any user can
    // run this pipeline at any site with zero personal setup. The
    // credentials in assets/pasa_conf/conf.txt are NOT secrets -- see that
    // file's own comment: the MariaDB instance they log into is created
    // fresh per-task, loopback-only, and destroyed at task end.
    pasa_conf_dir        = "${projectDir}/assets/pasa_conf"

    // ── optional annotation steps ─────────────────────────────────────────────
    run_update           = false
    run_annotate         = false
    run_antismash        = false
    run_interpro         = false
    // InterProScan engine. 'ips6' (default): INTERPROSCAN_RUN launches the
    // InterProScan 6 Nextflow workflow nested, per genome, with its own
    // containers (needs host nextflow + apptainer/singularity/docker; see
    // modules/local/interproscan_run.nf). 'ips5': legacy INTERPROSCAN5_RUN
    // runs `interproscan.sh` from the label's module/env (e.g. UCR's
    // `module load interproscan`, 5.x).
    interproscan_engine  = 'ips6'
    // IPS6 workflow: a local checkout (absolute path, run as-is) or a remote
    // name pulled at iprscan6_revision. Parallel genomes pulling a remote
    // name at once can race, so sites should clone once with
    // scripts/setup_interproscan6.sh and point this at the checkout.
    iprscan6_pipeline    = 'ebi-pf-team/interproscan6'
    iprscan6_revision    = '6.0.2.2'
    iprscan6_nextflow    = 'nextflow'
    // IPS6 container-engine profile: apptainer | singularity | docker | podman
    iprscan6_profile     = 'apptainer'
    // InterPro + member-DB data, laid out <datadir>/<db>/<version>/. IPS6
    // downloads anything missing (~50+ GB), so pre-populate it once
    // (scripts/setup_interproscan6.sh --data) rather than per genome.
    iprscan6_datadir     = "${launchDir}/interproscan6_data"
    // Pinned InterPro data release (must be in IPS6's compatible list,
    // https://ftp.ebi.ac.uk/pub/software/unix/iprscan/6/6.0/versions.json).
    // Keep this equal to the InterPro Matches API release
    // (https://www.ebi.ac.uk/interpro/matches/api/info): IPS6 does not
    // check that they match, and proteins found in the API get its release.
    iprscan6_interpro    = '110.0'
    // CPUs per IPS6 sub-task (hmmsearch etc.); the task's cpus cap how many
    // sub-tasks run at once (IPS6 --max-workers).
    iprscan6_task_cpus   = 4
    // Reuse precomputed matches from the InterPro Matches API for proteins
    // already in UniParc. Needs outbound HTTPS from the compute node.
    iprscan6_matches_api = true
    // null = IPS6's default (all non-deep-learning analyses). Comma list,
    // e.g. 'pfam,panther,cdd' to restrict.
    iprscan6_applications = null
    // Optional -c config enabling licensed apps (params.appsConfig.<app>.dir);
    // UCR example: assets/interproscan6/licensed_ucr_hpcc.config.
    iprscan6_licensed_config = null
    // Extra container-engine options for IPS6's containers (e.g. -B binds).
    iprscan6_container_options = ''
    // Anything else to pass to the IPS6 run verbatim.
    iprscan6_extra_args  = ''
    run_signalp          = false
    // GPU vs CPU-only SignalP (--nv passthrough + gpu-gres'd queue vs epyc).
    // The signalp6-fast.sif checkpoint is saved for CPU by default; GPU mode
    // needs a one-time `signalp6_convert_models` pass (needs a real GPU to
    // run) into a writable, persistent model dir -- SIGNALP_RUN does this
    // itself the first time and reuses it after, caching at signalp_gpu_models.
    signalp_gpu          = true
    // Same cache dir as the .sif images (params.sif_dir, resolved in
    // nextflow.config from NXF_APPTAINER_CACHE / NXF_SINGULARITY_CACHE /
    // APPTAINER_CACHE) -- this is just a converted-weights cache alongside them.
    signalp_gpu_models   = "${params.sif_dir}/signalp6-fast-gpu-models"
    run_deeptmhmm        = false
    // GPU vs CPU-only DeepTMHMM (--nv passthrough + gpu-gres'd queue vs epyc);
    // same container/command either way — see conf/provision_singularity.config.
    deeptmhmm_gpu        = true
    antismash_taxon      = "fungi"
    // antiSMASH reference databases (ClusterBlast/MIBiG/PFAM/etc). The
    // antismash-lite biocontainer ships no DBs -- SETUP_ANTISMASH_DB populates
    // this once via `download-antismash-databases`, storeDir-cached like
    // funannotate_db, so the portable default just caches it under launchDir.
    // Override to a prebuilt shared install to skip the download (e.g. UCR
    // HPCC: conf/site_ucr_hpcc.config → /bigdata/stajichlab/shared/lib/antismash_db).
    antismash_db         = "${launchDir}/data/antismash_db"
}

workDir = "${launchDir}/work/annotate"
cleanup = false

// Unconditional (not gated behind -profile singularity's own apptainer.enabled):
// BUSCO_COMPLETENESS always runs containerized regardless of provisioning axis
// (conda/pixi/ucr_hpcc/singularity), so its version/environment never becomes
// a confound in the conda-vs-container / version comparison itself. Harmless
// for every other process here: apptainer.enabled is just a global switch --
// a process only actually runs in a container if it ALSO has its own
// `container =` directive resolved, which no conda/pixi/ucr_hpcc-axis process
// gets from this file.
apptainer.enabled = true

// queue names, clusterOptions, and GPU options are UCR HPCC SLURM-specific —
// they live in conf/provision_ucr_hpcc.config, not here. This block contains
// only hardware resource requirements (cpus, memory, time) that are site-agnostic.
process {

    // Always-containerized regardless of provisioning axis -- see the
    // apptainer.enabled comment above and modules/local/busco_completeness.nf.
    // containerOptions binds the shared BUSCO v10 lineage mirror in read-only
    // so the container can see params.busco_lineages without a fresh
    // `busco --download` per lineage.
    withLabel: 'busco_completeness' {
        container        = params.container_busco_completeness
        // Closure, not an eagerly-interpolated string: this file loads FIRST
        // in every -profile combo (annotate,...,ucr_hpcc,<axis> -- ucr_hpcc
        // comes later), so a plain "${params.busco_lineages}" string would
        // freeze in the placeholder default (${launchDir}/busco_lineages)
        // before conf/site_ucr_hpcc.config overrides it to the real shared
        // mirror. A closure defers evaluation until Nextflow actually
        // resolves the directive for a task, by which point every config
        // file has been merged and params.busco_lineages holds its final
        // value. Confirmed via `nextflow config`: a plain string here baked
        // in the wrong (unresolved) path even under the real launch profile.
        containerOptions = { "-B ${params.busco_lineages}:${params.busco_lineages}" }
        // Host-side apptainer/singularity binary needs to be on $PATH in every
        // task shell regardless of axis (conda/pixi/ucr_hpcc don't module-load
        // it themselves) -- same guard as every withLabel beforeScript in
        // conf/provision_ucr_hpcc.config, kept here too since this label isn't
        // defined there (nothing to clobber it).
        beforeScript     = 'source /etc/profile.d/modules.sh 2>/dev/null || true; module load apptainer 2>/dev/null || true'
    }
    withName: '.*:BUSCO_COMPLETENESS' {
        cpus = 8; memory = '16 GB'; time = '2h'
    }

    withName: 'SETUP_TAXONDB' {
        cpus = 1; memory = '4 GB'; time = '1h'
    }

    withName: 'SETUP_FUNANNOTATE_DB' {
        // Network-bound multi-GB download of BUSCO + all funannotate DBs.
        // Runs once per project, then storeDir-skipped.
        cpus = 2; memory = '8 GB'; time = '12h'
    }

    withName: 'SETUP_AUGUSTUS_CONFIG' {
        // Local filesystem copy of the installed augustus config; quick, runs once.
        cpus = 1; memory = '4 GB'; time = '30m'
    }

    withName: '.*:GENOME_CLEAN' {
        // Full FCS-GX purge needs highmem (stages ~470 GB gx db into /dev/shm);
        // with --skip_fcs it's a light decompress + length-filter.
        cpus   = params.skip_fcs ? 2      : 16
        memory = params.skip_fcs ? '8 GB' : '500 GB'
        time   = params.skip_fcs ? '1h'   : '6h'
    }

    withName: '.*:GENOME_CLEAN_BATCH' {
        // Stages the ~470 GB FCS-GX db into /dev/shm once, then cleans
        // clean_batch_size genomes sequentially — needs highmem + long walltime.
        cpus = 16; memory = '500 GB'; time = '7d'
    }

    withName: '.*:MASKREPEAT_TANTAN_RUN' {
        cpus = 8; memory = '16 GB'; time = '2h'
    }

    // EarlGrey TE-discovery path (run_earlgrey=true).
    withName: '.*:EARLGREY_BUILD_LIB' {
        cpus = 32; memory = '64 GB'; time = '7d'
    }
    withName: '.*:REPEATMASK_STRAIN' {
        cpus = 32; memory = '32 GB'; time = '8h'
    }
    withName: '.*:DELIVER_MASK' {
        cpus = 1; memory = '2 GB'; time = '30m'
    }

    withName: '.*:SRA_QUERY_BATCH' {
        cpus = 1; memory = '4 GB'; time = '2h'
        maxForks = 10; errorStrategy = 'retry'; maxRetries = 2
    }
    withName: '.*:COLLECT_SRA_QUERY' {
        cpus = 1; memory = '2 GB'; time = '20m'
    }
    withName: '.*:WRITE_EMPTY_READS' {
        cpus = 1; memory = '1 GB'; time = '5m'
    }

    withName: '.*:SRA_FETCH' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }; maxRetries = 5
        memory = { task.attempt == 1 ? '48 GB'  : '192 GB' }
        time   = { task.attempt == 1 ? '2h' : task.attempt == 2 ? '8h' : task.attempt == 3 ? '24h' : '48h' }
        cpus   = { task.attempt == 1 ? 24 : 32 }
    }
    withName: '.*:SRA_FETCH_SE' {
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }; maxRetries = 5
        memory = { task.attempt == 1 ? '48 GB'  : '192 GB' }
        time   = { task.attempt == 1 ? '2h' : task.attempt == 2 ? '8h' : '24h' }
        cpus   = { task.attempt == 1 ? 24 : 32 }
    }

    withName: '.*:RNASEQ_PREPARE' {
        cpus = 16
        memory = { task.attempt == 1 ? '52 GB' : (48 + (task.attempt - 1) * 48) + ' GB' }
        time = '120h'; maxRetries = 3
    }

    withName: '.*:FUNANNOTATE_TRAIN' {
        maxRetries = 3
        memory     = { task.attempt == 1 ? '48 GB' : task.attempt == 2 ? '192 GB' : '256 GB' }
        time       = { task.attempt == 1 ? '72h' : '120h' }
        cpus       = { task.attempt == 1 ? 8 : 24 }
    }

    withName: '.*:FUNANNOTATE_PREDICT' {
        memory = { task.attempt == 1 ? '32 GB' : '64 GB' }
        time   = '72h'
        cpus   = { task.attempt == 1 ? 8 : 16 }
    }

    // PREDICT_REUSE runs a second FUNANNOTATE_PREDICT instance for eligible
    // siblings (FUNANNOTATE_PREDICT_SIB) — same hardware envelope as the
    // rep/independent instance.
    withName: '.*:FUNANNOTATE_PREDICT_SIB' {
        memory = { task.attempt == 1 ? '32 GB' : '64 GB' }
        time   = '72h'
        cpus   = { task.attempt == 1 ? 8 : 16 }
    }

    withName: '.*:GENEMARK_RUN' {
        cpus = 8; memory = '32 GB'; time = '4h'
    }

    withName: '.*:GENEMARK_RUN_SIB' {
        cpus = 8; memory = '32 GB'; time = '4h'
    }

    withName: '.*:ANTISMASH_RUN' {
        // 8h with no retry/escalation let SLURM walltime-kill 8/14 genomes
        // in a real run (Desert_microbes/Culture_genomes, 2026-09-27) with
        // zero retries configured -- default errorStrategy='terminate' took
        // down the whole session, losing ~7.5h of in-progress antiSMASH work
        // per genome. All 8 killed genomes hadn't finished at the full 8h,
        // so attempt 1 starts at 24h directly (not 8h) -- no point repeating
        // a walltime we already know is too short before escalating further.
        cpus   = 8
        memory = '24 GB'
        time   = { task.attempt == 1 ? '24h' : '48h' }
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // IPS6 (nested run): cpus = parallel IPS6 sub-tasks; memory is split
    // between the nested head JVM and its sub-tasks inside the module.
    withName: '.*:INTERPROSCAN_RUN' {
        cpus = 16; memory = '48 GB'; time = '24h'
    }
    withName: '.*:INTERPROSCAN5_RUN' {
        cpus = 8; memory = '32 GB'; time = '60h'
    }

    withName: '.*:SIGNALP_RUN' {
        cpus   = params.signalp_gpu ? 4 : 16
        memory = params.signalp_gpu ? '16 GB' : '64 GB'
        time   = params.signalp_gpu ? '2h' : '8h'
    }

    withName: '.*:DEEPTMHMM_ANNOTATION' {
        cpus   = params.deeptmhmm_gpu ? 4 : 16
        memory = params.deeptmhmm_gpu ? '16 GB' : '32 GB'
        time   = params.deeptmhmm_gpu ? '2h' : '12h'
    }

    withName: '.*:BUSCO_GENOME' {
        maxRetries = 3
        cpus       = { task.attempt == 1 ? 8 : 16 }
        memory     = { task.attempt == 1 ? '4 GB' : task.attempt == 2 ? '8 GB' : '96 GB' }
        time       = { task.attempt == 1 ? '2h' : '6h' }
    }

    withName: '.*:SKANI_COMPARE' {
        cpus = 16; memory = '32 GB'; time = '12h'
    }

    // Small, single-threaded aggregation steps of the ANI front-end.
    withName: '.*:CONCAT_ANI_TSVS'            { cpus = 1; memory = '4 GB'; time = '1h' }
    withName: '.*:PICK_REPRESENTATIVE_STRAIN' { cpus = 2; memory = '8 GB'; time = '4h' }
    withName: '.*:ASM_STATS'                  { cpus = 2; memory = '8 GB'; time = '2h' }

    withName: '.*:FUNANNOTATE_ANNOTATE' {
        cpus = 16; memory = '64 GB'; time = '24h'
    }
    withName: '.*:FUNANNOTATE_UPDATE' {
        cpus = 16; memory = '64 GB'; time = '48h'
    }
}

// file carries a per-invocation timestamp (not a fixed name): with
// overwrite=true and one filename, every `-resume` relaunch wiped out the
// PREVIOUS invocation's trace rows, including for genomes that were already
// cache-hit/completed in that run -- their task-level realtime/cpu/rss was
// silently lost (confirmed on a benchmark cell resumed many times: its trace
// showed 5 rows despite 57/65 genomes having real published output).
// Funannotate_benchmarking's scripts/collect_metrics.py globs
// annotate_trace.*.txt per cell and merges all snapshots rather than reading
// one fixed file.
// Resource/placement fields (attempt..peak_rss) added 2026-09-23: without them
// a task that completed on attempt 1 (e.g. TRAIN: 8 cpus, epyc) and one that
// completed on attempt 3 (24 cpus, highmem) are indistinguishable, and `rss`
// is the process's resident memory, not its peak (`peak_rss`). start/complete
// give true per-genome wall clock instead of a sum of task realtime.
trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/annotate_trace.${new Date().format('yyyyMMdd_HHmmss')}.txt"
    overwrite = true
    fields    = 'task_id,hash,name,status,exit,realtime,%cpu,rss,tag,attempt,cpus,memory,queue,hostname,submit,start,complete,peak_rss'
}
report {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/annotate_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/annotate_timeline.html"
    overwrite = true
}
