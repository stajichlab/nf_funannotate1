/*
 * conf/modules.config — per-module publishDir and ext.args
 *
 * Keeps process definitions in modules/local/ free of pipeline-specific paths.
 * Every publishDir that references params.target or other pipeline-level
 * directories belongs here rather than in the module file.
 *
 * ext.args can be used to pass extra CLI flags to tools without editing modules.
 */

process {

    withName: 'INTERPROSCAN_RUN' {
        publishDir = [
            path:      { params.target },
            mode:      'copy',
            overwrite: true
        ]
    }

    // ANTISMASH_RUN and SIGNALP_RUN no longer need a publishDir here: both
    // write their real output directly to params.target/${meta.id}/... inside
    // their own scripts (Option B persistence, matching FUNANNOTATE_PREDICT)
    // rather than to a task-workdir-relative path -- see modules/local/
    // antismash_run.nf and signalp_run.nf. A publishDir keyed on a relative
    // output path (as this used to be) only fires on task SUCCESS, which
    // never happened while these tasks were crashing on pigz/ps -- writing
    // directly means real analysis output survives even a late failure.
}
