/*
 * genemark_sidecar pipeline profile — resources for genemark_sidecar.nf.
 * See that file's header for what this entrypoint does and why.
 */

params {
    target = "${launchDir}/output"
}

process {
    withLabel: 'genemark' {
        cpus = 8; memory = '32 GB'; time = '4h'
    }
    // 'process_single' (PUBLISH_GENEMARK) already gets sane defaults from
    // conf/base.config (1 cpu / 6 GB / 4h) -- no override needed here.
}
