/*
 * genemark_sidecar pipeline profile — resources for genemark_sidecar.nf.
 * See that file's header for what this entrypoint does and why.
 */

params {
    target = "${launchDir}/output"

    // GENEMARK_RUN (subworkflows/local/genemark_run.nf; process modules/local/genemark_train.nf) interpolates these into its
    // predict-guard / intron-length CLI args regardless of pipeline profile.
    // The sidecar doesn't load the `annotate` profile, so without these here
    // they render as literal "null" and every GENEMARK_RUN task fails before
    // GeneMark even starts. Same values as conf/profile_annotate.config.
    max_intronlen            = 3000
    predict_min_asm_bp       = 9000000
    predict_frag_max_n50     = 15000
    predict_frag_max_contigs = 1000
    predict_abs_min_asm_bp   = 100000
    predict_min_training_contig_len = 10000
    predict_min_training_contigs    = 1

    // Chunked GeneMark route (subworkflows/local/genemark_run.nf). OFF by default: with false every genome takes
    // the old single-task route. A genome with >= genemark_chunk_min_contigs contigs that trains fresh in ES mode
    // (container mode only) is trained once, predicted in chunks of ~genemark_chunk_contigs contigs, then merged.
    // Keep gmes --soft_mask numeric: 'auto' depends on input size and would differ between a chunk and the genome.
    genemark_chunked           = false
    genemark_chunk_min_contigs = 25000
    genemark_chunk_contigs     = 20000    // ~45 min per chunk at 0.13 s/contig on 8 cores
    genemark_chunk_min_bp      = 100000   // gmes_petap.pl exits with an error on input under 100,000 bp
}

process {
    withLabel: 'genemark' {
        cpus = 8; memory = '32 GB'; time = '4h'
    }
    // Chunked route. Defaults here; the queue / time ladder is in the site config (conf/site_ucr_hpcc*.config,
    // conf/provision_ucr_hpcc.config). A permanently failed chunk or merge is ignored after the last retry (as in
    // BFD): that genome gets no GTF; bin/genemark_chunked_missing.py lists such genomes after a run.
    withName: '.*:GENEMARK_PREDICT_CHUNK' {
        cpus          = 8
        memory        = { (8 * Math.pow(2, task.attempt - 1)) + ' GB' }
        time          = '2h'
        errorStrategy = { task.attempt < 4 ? 'retry' : 'ignore' }
        maxRetries    = 3
        maxForks      = 32
    }
    withName: '.*:GENEMARK_MERGE' {
        cpus          = 2
        memory        = { (4 * task.attempt) + ' GB' }
        time          = '1h'
        errorStrategy = { task.attempt < 3 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    // 'process_single' (PUBLISH_GENEMARK) and 'process_medium'
    // (ALIGN_RNASEQ_HINTS) already get sane defaults from conf/base.config --
    // no override needed here.
}

// Own trace/report/timeline (same pattern as conf/profile_annotate.config),
// so this shared, one-time-per-genome cost is separately visible and can be
// folded into total benchmark cost accounting (once, not once per cell) --
// see Funannotate_benchmarking scripts/collect_metrics.py.
// Timestamped filename -- see conf/profile_annotate.config's trace{} comment
// for why a fixed name + overwrite=true silently loses history across resumes.
trace {
    enabled  = true
    file     = "${launchDir}/logs/nextflow/genemark_sidecar_trace.${new Date().format('yyyyMMdd_HHmmss')}.txt"
    overwrite = true
    fields   = 'task_id,hash,name,status,exit,realtime,%cpu,rss,tag,attempt,cpus,memory,queue,hostname,submit,start,complete,peak_rss'
}

report {
    enabled  = true
    file     = "${launchDir}/logs/nextflow/genemark_sidecar_report.html"
    overwrite = true
}

timeline {
    enabled  = true
    file     = "${launchDir}/logs/nextflow/genemark_sidecar_timeline.html"
    overwrite = true
}
