/*
 * UCR HPCC — OPT-IN SLURM `preempt` partition/account override.
 *
 * Include this file LAST, after the other site configs, e.g.:
 *   nextflow run ... \
 *     -profile annotate,slurm,singularity \
 *     -c conf/site_ucr_hpcc.config \
 *     -c conf/site_ucr_hpcc_singularity.config \
 *     -c conf/site_ucr_hpcc_preempt.config
 *
 * What it does: routes the attempt-1 (≤24h-capable) tasks of the annotation
 * pipeline to the preempt partition with --account=preempt for cheaper
 * throughput, exactly like BFD/Fungi_BFD_runs (do_annotation_asco) does on
 * this cluster. Rationale / constraints:
 *
 *  - preempt has a 1-day wall-clock cap, so attempt-1 TIME values are
 *    overridden to attempt*24h here (profile_annotate.config's 72h/120h
 *    defaults would be rejected); later attempts escalate past the cap and
 *    fall back to the default queue (epyc) via queue = '' with no --account.
 *  - c01-c30 are old AMD "Abu Dhabi" nodes with no AVX2; hisat2-build
 *    (RNASEQ_PREPARE) and funannotate binaries (augustus/bam2hints in
 *    FUNANNOTATE_TRAIN/PREDICT) SIGILL-crash on them instantly, so we pass
 *    --exclude=c[01-30] for those processes (confirmed in BFD's
 *    profile_funannotate.config).
 *  - Kept on their base config (NOT preempted): short/fast tasks, GPU tasks
 *    (SIGNALP_RUN/DEEPTMHMM_ANNOTATION via params.signalp_gpu), and tasks
 *    whose memory/time exceed preempt's envelope (INTERPROSCAN_RUN 60h,
 *    FUNANNOTATE_UPDATE 48h).
 *  - clusterOptions always carry the --export=ALL,SCRATCH=,TMPDIR= guard
 *    (per-task MariaDB datadir under $TMPDIR/$SCRATCH — see
 *    setup_mariadb_datadir / funannotate_train.nf) plus --job-name= when the
 *    base config sets one. If the withName list below ever diverges from
 *    site_ucr_hpcc_singularity.config, this file's entries win (same
 *    specificity, loaded later) — keep both in sync.
 */
process {
    withName: 'SETUP_FUNANNOTATE_DB' {
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt --export=ALL,SCRATCH=,TMPDIR='
    }

    withName: '.*:SRA_FETCH' {
        // Attempt 1 (2h) rides 'short'; a retry escalates to 8h/24h, still
        // inside preempt's 1-day cap, so retries get the cheaper account too.
        queue          = { task.attempt == 1 ? 'short' : 'preempt' }
        clusterOptions = { task.attempt == 1 ? '-N 1 -n 1 --export=ALL,SCRATCH=,TMPDIR=' : '-N 1 -n 1 --account=preempt --export=ALL,SCRATCH=,TMPDIR=' }
    }
    withName: '.*:SRA_FETCH_SE' {
        queue          = { task.attempt == 1 ? 'short' : 'preempt' }
        clusterOptions = { task.attempt == 1 ? '-N 1 -n 1 --export=ALL,SCRATCH=,TMPDIR=' : '-N 1 -n 1 --account=preempt --export=ALL,SCRATCH=,TMPDIR=' }
    }

    withName: '.*:RNASEQ_PREPARE' {
        queue          = { task.attempt == 1 ? 'preempt' : '' }
        time           = { (task.attempt * 24) + 'h' }
        clusterOptions = { task.attempt == 1 ? '-N 1 -n 1 --account=preempt --exclude=c[01-30] --export=ALL,SCRATCH=,TMPDIR=' : '-N 1 -n 1 --exclude=c[01-30] --export=ALL,SCRATCH=,TMPDIR=' }
    }

    withName: '.*:FUNANNOTATE_TRAIN' {
        // Retry fallback matches site_ucr_hpcc_singularity.config: attempt 2
        // stays on epyc, attempt 3+ escalates to highmem (256 GB profile ramps
        // don't fit epyc's r[21-40] nodes).
        queue          = { task.attempt == 1 ? 'preempt' : task.attempt <= 2 ? 'epyc' : 'highmem' }
        time           = { (task.attempt * 24) + 'h' }
        clusterOptions = { task.attempt == 1 ? '--job-name=nf-TRAIN --account=preempt --exclude=c[01-30] --export=ALL,SCRATCH=,TMPDIR=' : '--job-name=nf-TRAIN --exclude=c[01-30] --export=ALL,SCRATCH=,TMPDIR=' }
    }

    withName: '.*:FUNANNOTATE_PREDICT' {
        queue          = { task.attempt == 1 ? 'preempt' : '' }
        time           = { (task.attempt * 24) + 'h' }
        clusterOptions = { task.attempt == 1 ? '--job-name=nf-PREDICT --account=preempt --exclude=c[01-30] --export=ALL,SCRATCH=,TMPDIR=' : '--job-name=nf-PREDICT --exclude=c[01-30] --export=ALL,SCRATCH=,TMPDIR=' }
    }
    withName: '.*:FUNANNOTATE_PREDICT_SIB' {
        queue          = { task.attempt == 1 ? 'preempt' : '' }
        time           = { (task.attempt * 24) + 'h' }
        clusterOptions = { task.attempt == 1 ? '--job-name=nf-PREDICT-SIB --account=preempt --exclude=c[01-30] --export=ALL,SCRATCH=,TMPDIR=' : '--job-name=nf-PREDICT-SIB --exclude=c[01-30] --export=ALL,SCRATCH=,TMPDIR=' }
    }

    withName: '.*:GENEMARK_RUN' {
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 --job-name=nf-GENEMARK --account=preempt --export=ALL,SCRATCH=,TMPDIR='
    }
    withName: '.*:GENEMARK_RUN_SIB' {
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 --job-name=nf-GENEMARK-SIB --account=preempt --export=ALL,SCRATCH=,TMPDIR='
    }

    withName: '.*:ANTISMASH_RUN' {
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt --export=ALL,SCRATCH=,TMPDIR='
    }

    withName: '.*:FUNANNOTATE_ANNOTATE' {
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt --export=ALL,SCRATCH=,TMPDIR='
    }
}
